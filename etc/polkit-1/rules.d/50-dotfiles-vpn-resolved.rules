// Let user-run VPN clients (kvn-tui/sing-box as a systemd user service) set
// per-link DNS in systemd-resolved without a password prompt on every
// reconnect, e.g. after resume from suspend or hibernation.
polkit.addRule(function(action, subject) {
    if ((action.id == "org.freedesktop.resolve1.set-dns-servers" ||
         action.id == "org.freedesktop.resolve1.set-domains" ||
         action.id == "org.freedesktop.resolve1.set-default-route") &&
        subject.local && subject.isInGroup("network")) {
        return polkit.Result.YES;
    }
});
