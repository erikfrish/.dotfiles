{
    "label" : "lock",
    "action" : "~/.config/desktop/scripts/power_menu lock &",
    "text" : "Lock [l]",
    "keybind" : "l"
}
{
    "label" : "hibernate",
    "action" : "~/.config/desktop/scripts/power_menu hibernate &",
    "text" : "Hibernate [h]",
    "keybind" : "h"
}
{
    "label" : "logout",
    "action" : "~/.config/desktop/scripts/power_menu logout &",
    "text" : "Logout [e]",
    "keybind" : "e"
}
{
    "label" : "shutdown",
    "action" : "systemctl poweroff",
    "text" : "Shutdown [s]",
    "keybind" : "s"
}
{
    "label" : "suspend",
    "action" : "~/.config/desktop/scripts/power_menu sleep &",
    "text" : "Sleep [u]",
    "keybind" : "u"
}
{
    "label" : "reboot",
    "action" : "systemctl reboot",
    "text" : "Reboot [r]",
    "keybind" : "r"
}
{
    "label" : "screen-off",
    "action" : "~/.config/desktop/scripts/power_menu screen-off &",
    "text" : "Screen off [d]",
    "keybind" : "d"
}
