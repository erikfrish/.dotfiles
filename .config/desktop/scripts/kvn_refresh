#!/usr/bin/env bash
set -euo pipefail

# kvn connect/toggle return before the tunnel is up. Wait (up to 5 s) until
# kvn_status differs from the baseline passed as $1, then redraw Waybar at once
# instead of waiting for the next poll.

status="${0%/*}/kvn_status"
before="${1:-}"

for _ in $(seq 25); do
  if [ "$("$status")" != "$before" ]; then
    break
  fi
  sleep 0.2
done

pkill -RTMIN+11 -x waybar || true
