#!/usr/bin/env bash
set -euo pipefail

# Fix XWayland keymap: niri applies input.kdl through libxkbcommon, but
# XWayland/Java apps need the same user XKB layout loaded into the X server.
display="${DISPLAY:-:0}"
xkb_dir="${XDG_CONFIG_HOME:-$HOME/.config}/xkb"

for _ in {1..20}; do
    if keymap=$(DISPLAY="$display" setxkbmap -I"$xkb_dir" -layout us,dotfiles -variant ',ru_ctrl_shortcuts' -option grp:alt_shift_toggle -print 2>/dev/null); then
        if printf '%s\n' "$keymap" | DISPLAY="$display" xkbcomp -I"$xkb_dir" - "$display" >/dev/null 2>&1; then
            exit 0
        fi
    fi

    sleep 0.25
done

exit 1
