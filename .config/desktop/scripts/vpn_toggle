#!/usr/bin/env bash
set -euo pipefail

lib_file="${XDG_CONFIG_HOME:-$HOME/.config}/dotfiles/lib.sh"
[ -r "$lib_file" ] && . "$lib_file"
type dotfiles_load_machine_config >/dev/null 2>&1 && dotfiles_load_machine_config

slot="${1:-vpn1}"

connection="$(dotfiles_vpn_connection "$slot")" || exit 0

[ -n "$connection" ] || exit 0

if nmcli -g NAME connection show --active | grep -Fxq -- "$connection"; then
  nmcli connection down "$connection"
else
  nmcli connection up "$connection"
fi
