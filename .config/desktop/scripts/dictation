#!/usr/bin/env bash
# Toggle local voice dictation (NVIDIA Parakeet TDT v3 via the shared STT
# server). First run starts recording; second run transcribes and pastes.
set -euo pipefail

runtime_dir="${XDG_RUNTIME_DIR:?XDG_RUNTIME_DIR is required}"
state_dir="$runtime_dir/dotfiles-dictation"
audio_file="$state_dir/recording.wav"
pid_file="$state_dir/pw-record.pid"
stt_base_url="${DICTATION_STT_BASE_URL:-http://127.0.0.1:8001/v1}"
stt_health_url="${stt_base_url%/v1}/health"
stt_model="${DICTATION_STT_MODEL:-parakeet-tdt-0.6b-v3-int8}"

notify() {
    notify-send --app-name="Dictation" "$@"
}

recording_pid=""
if [[ -f "$pid_file" ]]; then
    recording_pid=$(<"$pid_file")
fi

if [[ -n "$recording_pid" ]] && kill -0 "$recording_pid" 2>/dev/null; then
    kill -INT "$recording_pid"
    for _ in {1..30}; do
        kill -0 "$recording_pid" 2>/dev/null || break
        sleep 0.1
    done
    rm -f "$pid_file"

    if [[ ! -s "$audio_file" ]] || (( $(stat -c %s "$audio_file") < 1024 )); then
        notify "Диктовка" "Запись слишком короткая — текст не распознан."
        exit 0
    fi
    notify "Диктовка" "Распознаю…"
    curl_args=(
        --fail --silent --show-error --max-time 180
        --form "file=@$audio_file;type=audio/wav"
        --form "model=$stt_model"
        --form 'response_format=json'
    )
    if [[ -n "${DICTATION_STT_LANGUAGE:-}" ]]; then
        curl_args+=(--form "language=$DICTATION_STT_LANGUAGE")
    fi
    if ! response=$(curl "${curl_args[@]}" "$stt_base_url/audio/transcriptions" 2>/dev/null); then
        notify "Диктовка" "Сервер распознавания недоступен или вернул ошибку."
        exit 1
    fi
    text=$(jq -r '.text // empty' <<<"$response" | tr '\n' ' ' | xargs)

    if [[ -z "$text" ]]; then
        notify "Диктовка" "Речь не распознана."
        exit 0
    fi

    printf '%s' "$text" | wl-copy
    wtype -M ctrl -k v -m ctrl
    notify "Диктовка" "Готово"
    exit 0
fi

if ! curl --fail --silent --max-time 2 "$stt_health_url" >/dev/null; then
    notify "Диктовка" "STT-сервер недоступен: $stt_health_url"
    exit 1
fi

rm -rf "$state_dir"
mkdir -p "$state_dir"

if wpctl get-volume @DEFAULT_AUDIO_SOURCE@ | grep -q 'MUTED'; then
    notify "Диктовка" "Микрофон выключен. Включите его и повторите."
    exit 0
fi

pw-record --container wav --rate 16000 --channels 1 --format s16 "$audio_file" >/dev/null 2>&1 &
echo "$!" > "$pid_file"
notify "Диктовка" "Запись началась. Нажмите Super+D ещё раз, чтобы закончить."
