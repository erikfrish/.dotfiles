#!/usr/bin/env bash
set -euo pipefail

runtime_dir="${XDG_RUNTIME_DIR:-/tmp}/cliphist-menu"
thumb_dir="$runtime_dir/thumbs"

if pidof rofi >/dev/null 2>&1; then
  pkill rofi
  exit 0
fi

mkdir -p "$thumb_dir"

make_image_entry() {
  local line="$1" id raw thumb meta dims

  id=${line%%$'\t'*}
  raw="$runtime_dir/$id.clip"
  thumb="$thumb_dir/$id.png"
  meta="$thumb_dir/$id.txt"

  if [ ! -f "$thumb" ] || [ ! -f "$meta" ]; then
    if printf '%s\n' "$line" | cliphist decode >"$raw" && identify -quiet "$raw" >/dev/null 2>&1; then
      identify -format '%wx%h %m' "$raw" >"$meta" 2>/dev/null || rm -f "$meta"
      magick "$raw[0]" -auto-orient -thumbnail '96x96>' "$thumb" >/dev/null 2>&1 || rm -f "$thumb"
    fi
    rm -f "$raw"
  fi

  if [ -f "$thumb" ]; then
    dims=$([ -f "$meta" ] && <"$meta" || printf 'image')
    printf 'Image %s\0icon\x1f%s\n' "$dims" "$thumb"
  else
    printf 'Binary data\0icon\x1fxterm\n'
  fi
}

make_text_entry() {
  local line="$1" preview
  preview=${line#*$'\t'}
  preview=${preview//$'\t'/ }
  printf '%s\n' "$preview"
}

cliphist list | while IFS= read -r line; do
  if [[ "$line" == *"binary data"* ]]; then
    make_image_entry "$line"
  else
    make_text_entry "$line"
  fi
done | rofi -dmenu \
  -i \
  -no-custom \
  -p "Clipboard" \
  -display-columns 1 \
  -config ~/.config/rofi/clipboard.rasi \
  -format i \
  -sync | {
    index=$(cat)
    [[ "$index" =~ ^[0-9]+$ ]] || exit 0
    cliphist list | sed -n "$((index + 1))p" | cliphist decode | wl-copy
  }
