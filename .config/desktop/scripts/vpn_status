#!/usr/bin/env bash
set -euo pipefail

lib_file="${XDG_CONFIG_HOME:-$HOME/.config}/dotfiles/lib.sh"
[ -r "$lib_file" ] && . "$lib_file"
type dotfiles_load_machine_config >/dev/null 2>&1 && dotfiles_load_machine_config

slot="${1:-vpn1}"

case "$slot" in
  vpn1)
    label="${DOTFILES_VPN1_LABEL:-Личный VPN}"
    icon="${DOTFILES_VPN1_ICON:-}"
    ;;
  vpn2)
    label="${DOTFILES_VPN2_LABEL:-Рабочий VPN}"
    icon="${DOTFILES_VPN2_ICON:-}"
    ;;
  *)
    printf '{"text":"","class":"inactive","tooltip":"Unknown VPN slot"}\n'
    exit 0
    ;;
esac

connection="$(dotfiles_vpn_connection "$slot")"

if [ -z "$connection" ]; then
  printf '{"text":"","class":"inactive","tooltip":"%s: not configured"}\n' "$label"
  exit 0
fi

if nmcli -g NAME connection show --active | grep -Fxq -- "$connection"; then
  printf '{"text":"%s","class":"active","tooltip":"%s\\n%s: включен\\nЛКМ: выключить · ПКМ: выбрать"}\n' "$icon" "$label" "$connection"
else
  printf '{"text":"%s","class":"inactive","tooltip":"%s\\n%s: выключен\\nЛКМ: включить · ПКМ: выбрать"}\n' "$icon" "$label" "$connection"
fi
