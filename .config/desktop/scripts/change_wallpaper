#!/usr/bin/env bash
set -euo pipefail

lib_file="${XDG_CONFIG_HOME:-$HOME/.config}/dotfiles/lib.sh"
[ -r "$lib_file" ] && . "$lib_file"
type dotfiles_load_machine_config >/dev/null 2>&1 && dotfiles_load_machine_config

wallpaper_dir="${DOTFILES_WALLPAPER_DIR:-$HOME/Pictures/Wallpapers}"
state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/wallpaper"
state_file="$state_dir/current"
video_pid_file="$state_dir/mpvpaper.pid"
thumb_dir="${XDG_CACHE_HOME:-$HOME/.cache}/wallpaper-thumbnails"
video_preview_second=1
mpv_hwdec="${DOTFILES_MPV_HWDEC:-no}"
awww_unit="dotfiles-awww-daemon.service"
mpvpaper_unit="dotfiles-mpvpaper.service"

if [ ! -d "$wallpaper_dir" ]; then
  printf 'Wallpaper directory does not exist: %s\n' "$wallpaper_dir" >&2
  exit 1
fi

mapfile -d '' wallpapers < <(
  find "$wallpaper_dir" -maxdepth 1 -type f \
    \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.gif' -o -iname '*.webp' -o -iname '*.mp4' -o -iname '*.webm' -o -iname '*.mkv' \) \
    -print0 | sort -z
)

if [ "${#wallpapers[@]}" -eq 0 ]; then
  printf 'No wallpapers found in %s\n' "$wallpaper_dir" >&2
  exit 1
fi

systemd_user_available() {
  command -v systemd-run >/dev/null 2>&1 && systemctl --user show-environment >/dev/null 2>&1
}

start_detached() {
  if command -v setsid >/dev/null 2>&1; then
    setsid -f "$@" >/dev/null 2>&1
  else
    nohup "$@" >/dev/null 2>&1 &
  fi
}

start_awww_daemon() {
  if systemd_user_available; then
    systemctl --user reset-failed "$awww_unit" >/dev/null 2>&1 || true
    systemd-run --user --unit="${awww_unit%.service}" --collect --quiet awww-daemon >/dev/null 2>&1 && return 0
  fi

  start_detached awww-daemon
}

ensure_awww() {
  if ! awww query >/dev/null 2>&1; then
    start_awww_daemon
    for _ in {1..20}; do
      awww query >/dev/null 2>&1 && return 0
      sleep 0.05
    done
  fi
}

start_video_wallpaper() {
  local file="$1"
  local opts="no-audio --hwdec=$mpv_hwdec --loop-file=inf --panscan=1.0 --video-unscaled=no --keepaspect=yes --start=$video_preview_second"

  if systemd_user_available; then
    systemctl --user stop "$mpvpaper_unit" >/dev/null 2>&1 || true
    systemctl --user reset-failed "$mpvpaper_unit" >/dev/null 2>&1 || true
    if systemd-run --user --unit="${mpvpaper_unit%.service}" --collect --quiet mpvpaper -o "$opts" '*' "$file" >/dev/null 2>&1; then
      rm -f "$video_pid_file"
      return 0
    fi
  fi

  mpvpaper -o "$opts" '*' "$file" >/dev/null 2>&1 &
  printf '%s\n' "$!" >"$video_pid_file"
}

stop_video_wallpaper() {
  systemctl --user stop "$mpvpaper_unit" >/dev/null 2>&1 || true
  if [ -f "$video_pid_file" ]; then
    local pid
    pid=$(<"$video_pid_file")
    if [ -n "$pid" ]; then
      kill "$pid" 2>/dev/null || true
    fi
    rm -f "$video_pid_file"
  fi
}

stop_image_wallpaper() {
  awww kill >/dev/null 2>&1 || true
}

is_video() {
  case "${1,,}" in
    *.mp4|*.webm|*.mkv) return 0 ;;
    *) return 1 ;;
  esac
}

thumbnail_for_video() {
  local file="$1"

  command -v ffmpeg >/dev/null 2>&1 || return 1
  mkdir -p "$thumb_dir"

  local hash thumb
  hash=$(printf '%s' "$file" | sha256sum | cut -d' ' -f1)
  thumb="$thumb_dir/$hash-full.jpg"

  if [ ! -f "$thumb" ] || [ "$file" -nt "$thumb" ]; then
    ffmpeg -hide_banner -loglevel error -ss "$video_preview_second" -i "$file" -frames:v 1 -vf 'scale=1920:-1' -y "$thumb" >/dev/null 2>&1 || return 1
  fi

  [ -f "$thumb" ] || return 1
  printf '%s\n' "$thumb"
}

choose_random() {
  local previous="" candidate
  [ -f "$state_file" ] && previous=$(<"$state_file")

  if [ "${#wallpapers[@]}" -eq 1 ]; then
    printf '%s\n' "${wallpapers[0]}"
    return 0
  fi

  for _ in {1..10}; do
    candidate=${wallpapers[$(shuf -i "0-$((${#wallpapers[@]} - 1))" -n 1)]}
    if [ "$candidate" != "$previous" ]; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done

  printf '%s\n' "$candidate"
}

apply_wallpaper() {
  local file="$1"
  mkdir -p "$state_dir"

  if is_video "$file"; then
    if ! command -v mpvpaper >/dev/null 2>&1; then
      notify-send "Wallpaper" "Install mpvpaper to use video wallpapers" 2>/dev/null || true
      printf 'mpvpaper is required for video wallpapers\n' >&2
      exit 1
    fi
    local thumb=""
    thumb=$(thumbnail_for_video "$file" || true)
    stop_video_wallpaper
    if [ -n "$thumb" ]; then
      ensure_awww
      awww img "$thumb" --transition-fps 30 --transition-type any --transition-duration 1.2
      sleep 1.2
    else
      stop_image_wallpaper
    fi
    start_video_wallpaper "$file"
  else
    stop_video_wallpaper
    ensure_awww
    awww img "$file" --transition-fps 30 --transition-type any --transition-duration 3
  fi

  printf '%s\n' "$file" >"$state_file"
}

apply_color() {
  local hex="${1#\#}"
  mkdir -p "$state_dir"
  stop_video_wallpaper
  ensure_awww
  awww clear "$hex"
  printf 'color:%s\n' "$hex" >"$state_file"
}

restore_wallpaper() {
  local remembered=""
  [ -f "$state_file" ] && remembered=$(<"$state_file")

  if [[ "$remembered" == color:* ]]; then
    apply_color "${remembered#color:}"
  elif [ -n "$remembered" ] && [ -f "$remembered" ]; then
    apply_wallpaper "$remembered"
  else
    apply_wallpaper "$(choose_random)"
  fi
}

case "${1:-restore}" in
  restore|'')
    restore_wallpaper
    ;;
  random|awww|swww)
    apply_wallpaper "$(choose_random)"
    ;;
  color:*)
    apply_color "${1#color:}"
    ;;
  *)
    if [ -f "$1" ]; then
      apply_wallpaper "$(realpath "$1")"
    else
      printf 'Unknown wallpaper mode or file: %s\n' "$1" >&2
      exit 2
    fi
    ;;
esac
