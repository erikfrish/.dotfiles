#!/usr/bin/env bash
set -euo pipefail

max_volume=150
max_volume_wp=1.5
step=5

have() {
  command -v "$1" >/dev/null 2>&1
}

refresh_waybar() {
  pkill -RTMIN+8 waybar 2>/dev/null || true
}

wob_fifo() {
  if [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ] && [ -p "/tmp/$HYPRLAND_INSTANCE_SIGNATURE.wob" ]; then
    printf '%s\n' "/tmp/$HYPRLAND_INSTANCE_SIGNATURE.wob"
  elif [ -p /tmp/niri.wob ]; then
    printf '%s\n' /tmp/niri.wob
  fi
}

show_wob() {
  local value fifo
  value=${1:-0}
  fifo=$(wob_fifo)
  [ -n "$fifo" ] || return 0
  timeout 0.5s bash -c 'printf "%s\n" "$1" >"$2"' _ "$value" "$fifo" >/dev/null 2>&1 || true
}

real_default_sink() {
  pactl list sinks short 2>/dev/null | awk '$2 !~ /(^easyeffects_sink$|Easy Effects Sink)/ { print $2; exit }'
}

avoid_effects_sink() {
  local default_sink fallback_sink
  have pactl || return 0
  default_sink=$(pactl get-default-sink 2>/dev/null || true)
  case "$default_sink" in
    easyeffects_sink|"Easy Effects Sink")
      fallback_sink=$(real_default_sink)
      [ -n "$fallback_sink" ] && pactl set-default-sink "$fallback_sink" 2>/dev/null || true
      ;;
  esac
}

wp_volume_line() {
  wpctl get-volume "$1" 2>/dev/null || true
}

wp_volume_percent() {
  wp_volume_line "$1" | awk '{ for (i = 1; i <= NF; i++) if ($i ~ /^[0-9]+(\.[0-9]+)?$/) { printf "%d\n", ($i * 100) + 0.5; exit } }'
}

wp_is_muted() {
  wp_volume_line "$1" | grep -q '\[MUTED\]'
}

pactl_default_sink() {
  pactl get-default-sink 2>/dev/null
}

pactl_default_source() {
  pactl get-default-source 2>/dev/null
}

pactl_volume_percent() {
  pactl get-${2}-volume "$1" 2>/dev/null | awk -F/ 'NR == 1 { gsub(/ /, "", $2); gsub(/%/, "", $2); print $2 }'
}

pactl_is_muted() {
  pactl get-${2}-mute "$1" 2>/dev/null | grep -q yes
}

get_volume() {
  local volume
  avoid_effects_sink
  if have wpctl; then
    if wp_is_muted '@DEFAULT_AUDIO_SINK@'; then
      echo 0
      return
    else
      volume=$(wp_volume_percent '@DEFAULT_AUDIO_SINK@')
      if [ -n "$volume" ]; then
        echo "$volume"
        return
      fi
    fi
  fi

  local sink
  sink=$(pactl_default_sink)
  if pactl_is_muted "$sink" sink; then
    echo 0
  else
    pactl_volume_percent "$sink" sink
  fi
}

get_mic_volume() {
  local volume
  if have wpctl; then
    if wp_is_muted '@DEFAULT_AUDIO_SOURCE@'; then
      echo 0
      return
    fi
    volume=$(wp_volume_percent '@DEFAULT_AUDIO_SOURCE@')
    if [ -n "$volume" ]; then
      echo "$volume"
      return
    fi
  fi

  local source
  source=$(pactl_default_source)
  if pactl_is_muted "$source" source; then
    echo 0
  else
    pactl_volume_percent "$source" source
  fi
}

get_icon() {
  local current
  current=$(get_volume)
  if [[ "$current" -eq 0 ]]; then
    echo "audio-volume-muted-symbolic"
  elif [[ "$current" -le 30 ]]; then
    echo "audio-volume-low-symbolic"
  elif [[ "$current" -le 60 ]]; then
    echo "audio-volume-medium-symbolic"
  else
    echo "audio-volume-high-symbolic"
  fi
}

inc_volume() {
  avoid_effects_sink
  if ! have wpctl || ! wpctl set-volume -l "$max_volume_wp" '@DEFAULT_AUDIO_SINK@' "${step}%+"; then
    pactl set-sink-volume "$(pactl_default_sink)" "+${step}%"
  fi
  show_wob "$(get_volume)"
  refresh_waybar
}

dec_volume() {
  avoid_effects_sink
  if ! have wpctl || ! wpctl set-volume '@DEFAULT_AUDIO_SINK@' "${step}%-"; then
    pactl set-sink-volume "$(pactl_default_sink)" "-${step}%"
  fi
  show_wob "$(get_volume)"
  refresh_waybar
}

toggle_mute() {
  avoid_effects_sink
  if ! have wpctl || ! wpctl set-mute '@DEFAULT_AUDIO_SINK@' toggle; then
    pactl set-sink-mute "$(pactl_default_sink)" toggle
  fi
  show_wob "$(get_volume)"
  refresh_waybar
}

toggle_mic() {
  if ! have wpctl || ! wpctl set-mute '@DEFAULT_AUDIO_SOURCE@' toggle; then
    pactl set-source-mute "$(pactl_default_source)" toggle
  fi
  show_wob "$(get_mic_volume)"
  refresh_waybar
}

inc_mic_volume() {
  if ! have wpctl || ! wpctl set-volume -l 1.0 '@DEFAULT_AUDIO_SOURCE@' "${step}%+"; then
    pactl set-source-volume "$(pactl_default_source)" "+${step}%"
  fi
  show_wob "$(get_mic_volume)"
  refresh_waybar
}

dec_mic_volume() {
  if ! have wpctl || ! wpctl set-volume '@DEFAULT_AUDIO_SOURCE@' "${step}%-"; then
    pactl set-source-volume "$(pactl_default_source)" "-${step}%"
  fi
  show_wob "$(get_mic_volume)"
  refresh_waybar
}

case "${1:-}" in
  --get) get_volume ;;
  --inc) inc_volume ;;
  --dec) dec_volume ;;
  --toggle) toggle_mute ;;
  --toggle-mic) toggle_mic ;;
  --get-icon) get_icon ;;
  --get-mic-icon) echo "microphone-sensitivity-high-symbolic" ;;
  --mic-inc) inc_mic_volume ;;
  --mic-dec) dec_mic_volume ;;
  *) get_volume ;;
esac
