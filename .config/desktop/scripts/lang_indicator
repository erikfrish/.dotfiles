#!/usr/bin/env bash
set -euo pipefail

if [[ "${1:-}" == cached ]]; then
  cache="${XDG_RUNTIME_DIR:-/tmp/desktop-$UID}/desktop-state/layout"
  if [[ -r "$cache" ]]; then
    cat "$cache"
    exit 0
  fi
fi

normalize_layout() {
  case "$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')" in
    *russian*|*ru*) printf 'ru\n' ;;
    *english*|*us*) printf 'en\n' ;;
    *) printf '%s\n' "$(printf '%s' "$1" | cut -c1-2 | tr '[:upper:]' '[:lower:]')" ;;
  esac
}

if [[ ":${XDG_CURRENT_DESKTOP:-}:" == *:Hyprland:* ]]; then
  if [ "${1:-}" = "index" ]; then
    hyprctl -j devices | jq -r 'first(.keyboards[] | select(.main) | .active_layout_index) // empty'
    exit 0
  fi
  if [ "${1:-}" = "next" ]; then
    hyprctl switchxkblayout all next >/dev/null
  fi
  if ! layout=$(hyprctl -j devices 2>/dev/null | jq -r 'first(.keyboards[] | select(.main) | .active_keymap) // empty'); then
    printf -- '--\n'
    exit 0
  fi
  if [ -n "$layout" ]; then
    normalize_layout "$layout"
  else
    printf -- '--\n'
  fi
  exit 0
fi

if [ "${1:-}" = "index" ]; then
  niri msg -j keyboard-layouts | jq -r '.current_idx'
  exit 0
fi

if ! niri msg keyboard-layouts >/dev/null 2>&1; then
  printf -- '--\n'
  exit 0
fi

if [ "${1:-}" = "next" ]; then
  niri msg action switch-layout next >/dev/null 2>&1 || true
fi

layout=$(niri msg keyboard-layouts | awk '/^ \*/ { sub(/^ \* [0-9]+ /, ""); print; exit }')
normalize_layout "$layout"
