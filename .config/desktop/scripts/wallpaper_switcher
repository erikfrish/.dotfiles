#!/usr/bin/env bash
set -euo pipefail

wallpaper_dir="$HOME/Pictures/Wallpapers"
change_wallpaper="$HOME/.config/desktop/scripts/change_wallpaper"
thumb_dir="${XDG_CACHE_HOME:-$HOME/.cache}/wallpaper-thumbnails"
state_file="${XDG_STATE_HOME:-$HOME/.local/state}/wallpaper/current"

is_video() {
  case "${1,,}" in
    *.mp4|*.webm|*.mkv) return 0 ;;
    *) return 1 ;;
  esac
}

thumbnail_for() {
  local file="$1"

  if ! is_video "$file"; then
    printf '%s\n' "$file"
    return 0
  fi

  if ! command -v ffmpeg >/dev/null 2>&1; then
    printf 'video-x-generic\n'
    return 0
  fi

  mkdir -p "$thumb_dir"

  local hash thumb
  hash=$(printf '%s' "$file" | sha256sum | cut -d' ' -f1)
  thumb="$thumb_dir/$hash.jpg"

  if [ ! -f "$thumb" ] || [ "$file" -nt "$thumb" ]; then
    ffmpeg -hide_banner -loglevel error -ss 00:00:01 -i "$file" -frames:v 1 -vf 'scale=512:-1' -y "$thumb" >/dev/null 2>&1 || true
  fi

  if [ -f "$thumb" ]; then
    printf '%s\n' "$thumb"
  else
    printf 'video-x-generic\n'
  fi
}

if pidof rofi >/dev/null 2>&1; then
  pkill rofi
  exit 0
fi

mapfile -d '' wallpapers < <(
  find "$wallpaper_dir" -maxdepth 1 -type f \
    \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.webp' -o -iname '*.gif' -o -iname '*.mp4' -o -iname '*.webm' -o -iname '*.mkv' \) \
    -print0 | sort -z
)

if [ "${#wallpapers[@]}" -eq 0 ]; then
  notify-send "Wallpaper" "No wallpapers found in $wallpaper_dir" 2>/dev/null || true
  exit 1
fi

selected_row=0
if [ -f "$state_file" ]; then
  current_wallpaper=$(<"$state_file")
  if [[ "$current_wallpaper" == color:* ]]; then
    selected_row="${#wallpapers[@]}"
    (( selected_row += 1 ))
  else
    current_wallpaper=$(realpath -m "$current_wallpaper")
    for i in "${!wallpapers[@]}"; do
      if [ "$(realpath -m "${wallpapers[$i]}")" = "$current_wallpaper" ]; then
        selected_row="$i"
        break
      fi
    done
  fi
fi

{
  printf 'Random\0icon\x1fshuffle\n'
  printf 'Solid Color\0icon\x1ffill-color\n'
  for wp in "${wallpapers[@]}"; do
    name=$(basename "$wp")
    printf '%s\0icon\x1f%s\n' "$name" "$(thumbnail_for "$wp")"
  done
} | rofi -dmenu \
  -i \
  -no-custom \
  -p "Wallpaper" \
  -config ~/.config/rofi/wallpaper.rasi \
  -selected-row "$selected_row" \
  -format s \
  -sync | {
    choice=$(cat)
    [ -n "$choice" ] || exit 0
    if [ "$choice" = "Random" ]; then
      exec "$change_wallpaper" random
    fi
    if [ "$choice" = "Solid Color" ]; then
      color=$(hyprpicker -a -f hex 2>/dev/null || true)
      [ -n "$color" ] || exit 0
      exec "$change_wallpaper" "color:${color#\#}"
    fi
    for wp in "${wallpapers[@]}"; do
      if [ "$(basename "$wp")" = "$choice" ]; then
        exec "$change_wallpaper" "$wp"
      fi
    done
  }
