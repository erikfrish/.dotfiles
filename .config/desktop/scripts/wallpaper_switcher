#!/usr/bin/env bash
set -euo pipefail

wallpaper_dir="$HOME/Pictures/Wallpapers"
wofi_config="$HOME/.config/wofi/config-clipboard"
wofi_style="$HOME/.config/wofi/style-compact.css"
wofi_colors="$HOME/.config/wofi/colors"
change_wallpaper="$HOME/.config/desktop/scripts/change_wallpaper"

mapfile -d '' wallpapers < <(
  find "$wallpaper_dir" -maxdepth 1 -type f \
    \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.webp' \) \
    -print0 | sort -z
)

if [ "${#wallpapers[@]}" -eq 0 ]; then
  notify-send "Wallpaper" "No wallpapers found in $wallpaper_dir" 2>/dev/null || true
  exit 1
fi

menu() {
  local i filename
  for i in "${!wallpapers[@]}"; do
    filename=$(basename "${wallpapers[$i]}" | sed 's/&/\&amp;/g')
    printf '%s. %s\n' "$i" "$filename"
  done
  printf 'RANDOM\n'
}

choice=$(
  menu | wofi --dmenu \
    --conf "$wofi_config" \
    --style "$wofi_style" \
    --color "$wofi_colors" \
    --prompt 'Wallpaper' \
    --cache-file=/dev/null
)

[ -n "$choice" ] || exit 0

if [ "$choice" = "RANDOM" ]; then
  exec "$change_wallpaper" random
fi

idx=$(printf '%s' "$choice" | grep -o '^[0-9]\+')
[ -n "$idx" ] || exit 0

exec "$change_wallpaper" "${wallpapers[$idx]}"
