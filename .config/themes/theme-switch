    read -r bg_r bg_g bg_b < <(hex_to_rgb "$bg")

    case "$waybar_shape" in
        zero-bar|omarchy-tight|hairline-blocks)
            radius=0
            icon_size=18
            margin=34
            ;;
        compact-pills|soft-islands)
            radius=18
            icon_size=20
            margin=38
            ;;
        *)
            radius=10
            icon_size=20
            margin=36
            ;;
    esac

    cat > "$style" <<WLOGOUT
/* Generated by theme-switch from $theme_name */
* {
    background-image: none;
    box-shadow: none;
    font-family: "JetBrainsMono Nerd Font", sans-serif;
