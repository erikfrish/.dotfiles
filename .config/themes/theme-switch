    done

    cat >> "$config_dir/rofi/clipboard-theme.rasi" <<'CLIPBOARD_ROFI'

element selected normal element-icon {
  size: 5.6em;
}

element selected urgent element-icon {
  size: 5.6em;
}

element selected active element-icon {
  size: 5.6em;
}
CLIPBOARD_ROFI

    cat >> "$config_dir/rofi/wallpaper-theme.rasi" <<'WALLPAPER_ROFI'

