apply_swaync() {
    local template="$config_dir/swaync/template.css"
    local style="$config_dir/swaync/style.css"
    local control_radius bubble_radius widget_radius
    if [[ ! -f "$template" ]]; then
        return
    fi

    case "$waybar_shape" in
        zero-bar|omarchy-tight|hairline-blocks)
            control_radius=0
            bubble_radius=0
            widget_radius=0
            ;;
        compact-pills|soft-islands)
            control_radius=18
            bubble_radius=16
            widget_radius=14
            ;;
        *)
            control_radius=10
            bubble_radius=8
            widget_radius=8
            ;;
    esac

    {
        cat <<COLORS
@define-color cc-bg ${bg};
@define-color noti-border-color ${fg};
@define-color noti-bg ${bg};
@define-color noti-bg-darker ${muted};
@define-color noti-bg-hover ${muted};
@define-color noti-bg-focus ${bg};
@define-color noti-close-bg ${fg};
@define-color noti-close-bg-hover ${fg};
@define-color text-color ${fg};
@define-color text-color-disabled ${muted};
@define-color bg-selected ${accent};
@define-color border-green ${ok};
@define-color border-blue ${accent};
@define-color red-base ${critical};
@define-color red-hover ${critical};
@define-color green-base ${ok};
@define-color blue-base ${accent};
COLORS
        tail -n +2 "$template"
        cat <<RADIUS

.control-center {
  border-radius: ${control_radius}px;
}

.notification,
.notification-content,
.notification-action,
.notification-default-action,
.inline-reply-entry,
.inline-reply-button,
.close-button {
  border-radius: ${bubble_radius}px;
}

.widget-title,
.widget-title>button,
.widget-dnd,
.widget-dnd>switch,
.widget-dnd>switch slider,
.widget-buttons-grid,
.widget-buttons-grid>flowbox>flowboxchild>button,
.widget-volume,
.widget-backlight,
.widget-mpris,
.widget-mpris-player,
.widget-mpris-album-art {
  border-radius: ${widget_radius}px;
}
RADIUS
    } > "$style"
    swaync-client --reload-css 2>/dev/null || killall -HUP swaync 2>/dev/null || true
}

