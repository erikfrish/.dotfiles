#!/usr/bin/env bash
set -euo pipefail

themes_dir="$HOME/.config/themes"
state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/themes"
state_file="$state_dir/current"
config_dir="$HOME/.config"

usage() {
    printf 'Usage: %s [apply THEME|menu|current|list]\n' "$(basename "$0")"
}

load_theme() {
    local name="$1"
    local conf="$themes_dir/${name}.conf"
    if [[ ! -f "$conf" ]]; then
        printf 'No such theme: %s\n' "$name" >&2
        exit 1
    fi
    source "$conf"
    theme_name="$name"
}

save_state() {
    mkdir -p "$state_dir"
    printf '%s\n' "$theme_name" > "$state_file"
}

current_theme() {
    if [[ -f "$state_file" ]]; then
        cat "$state_file"
    fi
}

list_themes() {
    shopt -s nullglob
    for f in "$themes_dir"/*.conf; do
        basename "$f" .conf
    done | sort
    shopt -u nullglob
}

hex_to_rgb() {
    local hex="${1#\#}"
    printf '%d %d %d\n' "0x${hex:0:2}" "0x${hex:2:2}" "0x${hex:4:2}"
}

apply_waybar() {
    local cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/waybar"
    local waybar_state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/waybar"
    mkdir -p "$cache_dir" "$waybar_state_dir"

    cat > "$waybar_state_dir/theme.conf" <<EOF
base=$waybar_base
palette=$waybar_palette
shape=$waybar_shape
accent=$waybar_accent
EOF

    cat > "$cache_dir/theme.css" <<EOF
/* Generated by theme-switch from $theme_name */
@import "themes/palette/$waybar_palette.css";
@import "themes/base/$waybar_base.css";
@import "themes/shape/$waybar_shape.css";
@import "themes/accent/$waybar_accent.css";
EOF

    ln -sf "$cache_dir/theme.css" "$config_dir/waybar/style.css"
    killall waybar 2>/dev/null || true
    nohup "$config_dir/waybar/scripts/statusbar" >/dev/null 2>&1 &
}

apply_rofi() {
    local bg_r bg_g bg_b
    read -r bg_r bg_g bg_b < <(hex_to_rgb "$bg")
    local bg_rgba="rgba(${bg_r}, ${bg_g}, ${bg_b}, 93%)"

    for target in theme wallpaper-theme clipboard-theme; do
        local dest="$config_dir/rofi/${target}.rasi"
        cat > "$dest" <<ROFI
* {
  bg:               ${bg_rgba};
  bg-input:         ${muted};
  fg:               ${fg};
  fg-selected:      ${bg};
  accent1:          ${accent};
  accent2:          ${accent_alt};
  urgent:           ${critical};
  border-clr:       ${muted};
  separator-clr:    ${muted};

  background-color: transparent;
  text-color:       var(fg);
  spacing:          4;
}

window {
  background-color: var(bg);
  border:           2px;
  border-color:     var(border-clr);
  border-radius:    8px;
  padding:          12px;
  width:            46%;
}

mainbox {
  padding: 0;
}

inputbar {
  background-color: var(bg-input);
  border:           1px;
  border-color:     var(border-clr);
  border-radius:    5px;
  padding:          8px 12px;
  margin:           0px 0px 8px 0px;
  children:         [prompt, entry];
}

prompt {
  text-color: var(accent1);
  margin:    0px 8px 0px 0px;
}

entry {
  text-color: var(fg);
}

listview {
  padding:      4px 0px;
  scrollbar:    true;
  spacing:      2px;
  fixed-height: false;
  lines:        14;
  columns:      2;
}

scrollbar {
  width:            4px;
  padding:          0;
  handle-width:     8px;
  handle-color:     var(accent1);
  border:           0px;
  background-color: transparent;
}

element {
  padding:       6px 8px;
  border-radius: 4px;
  spacing:       8px;
}

element normal normal {
  background-color: transparent;
  text-color:       var(fg);
}

element normal urgent {
  background-color: transparent;
  text-color:       var(urgent);
}

element normal active {
  background-color: transparent;
  text-color:       var(accent1);
}

element selected normal {
  background-image: linear-gradient(to right, ${accent}, ${accent_alt});
  text-color:       var(fg-selected);
}

element selected urgent {
  background-image: linear-gradient(to right, ${critical}, ${accent_alt});
  text-color:       var(fg-selected);
}

element selected active {
  background-image: linear-gradient(to right, ${accent}, ${accent_alt});
  text-color:       var(fg-selected);
}

element alternate normal {
  background-color: transparent;
  text-color:       var(fg);
}

element alternate urgent {
  background-color: transparent;
  text-color:       var(urgent);
}

element alternate active {
  background-color: transparent;
  text-color:       var(accent1);
}

element-icon {
  background-color: transparent;
  size:             1.2em;
}

element-text {
  background-color: transparent;
  text-color:       inherit;
  highlight:        inherit;
}

message {
  padding:      4px;
  border-color: var(separator-clr);
  border:       2px dash 0px 0px;
}

textbox {
  text-color: var(fg);
}

mode-switcher {
  margin:  8px 0px 0px 0px;
  spacing: 4px;
}

button {
  padding:       4px 12px;
  border-radius: 4px;
  text-color:    var(fg);
}

button selected {
  background-image: linear-gradient(to right, ${accent}, ${accent_alt});
  text-color:       var(fg-selected);
}

error-message {
  background-color: var(bg);
  text-color:       var(urgent);
  padding:          12px;
  border-radius:    8px;
}
ROFI
    done

    cat >> "$config_dir/rofi/wallpaper-theme.rasi" <<'WALLPAPER_ROFI'

window {
  width:   62%;
  padding: 16px;
}

listview {
  columns: 2;
  lines:   3;
  spacing: 6px;
}

element {
  orientation: vertical;
  padding:     8px;
  spacing:     6px;
}

element-icon {
  size: 8em;
}

element-text {
  horizontal-align: 0.5;
}
WALLPAPER_ROFI
}

apply_gtk() {
    gsettings set org.gnome.desktop.interface gtk-theme "$gtk_theme" 2>/dev/null || true
    gsettings set org.gnome.desktop.interface color-scheme 'prefer-dark' 2>/dev/null || true

    local gtk3_css="$config_dir/gtk-3.0/gtk.css"
    local gtk4_css="$config_dir/gtk-4.0/gtk.css"

    for css_file in "$gtk3_css" "$gtk4_css"; do
        cat > "$css_file" <<GTKCSS
/* Generated by theme-switch from $theme_name */
@define-color theme_fg_color ${fg};
@define-color theme_bg_color ${bg};
@define-color theme_selected_bg_color ${accent};
@define-color theme_selected_fg_color ${bg};
@define-color theme_unfocused_fg_color ${muted};
@define-color theme_unfocused_bg_color ${bg};
GTKCSS
    done
}

apply_swaync() {
    local template="$config_dir/swaync/template.css"
    local style="$config_dir/swaync/style.css"
    if [[ ! -f "$template" ]]; then
        return
    fi
    {
        cat <<COLORS
@define-color cc-bg ${bg};
@define-color noti-border-color ${fg};
@define-color noti-bg ${bg};
@define-color noti-bg-darker ${muted};
@define-color noti-bg-hover ${muted};
@define-color noti-bg-focus ${bg};
@define-color noti-close-bg ${fg};
@define-color noti-close-bg-hover ${fg};
@define-color text-color ${fg};
@define-color text-color-disabled ${muted};
@define-color bg-selected ${accent};
@define-color border-green ${ok};
@define-color border-blue ${accent};
@define-color red-base ${critical};
@define-color red-hover ${critical};
@define-color green-base ${ok};
@define-color blue-base ${accent};
COLORS
        tail -n +2 "$template"
    } > "$style"
    swaync-client --reload-css 2>/dev/null || killall -HUP swaync 2>/dev/null || true
}

apply_all() {
    apply_waybar
    apply_rofi
    apply_gtk
    apply_swaync
    save_state
}

menu() {
    if pidof rofi >/dev/null 2>&1; then
        pkill rofi
        exit 0
    fi

    local cur choice
    cur="$(current_theme)"

    choice=$(list_themes | while read -r name; do
        marker=" "
        [[ "$name" == "$cur" ]] && marker="*"
        printf '%s %s\n' "$marker" "$name"
    done | rofi -dmenu \
        -i \
        -no-custom \
        -p "Theme" \
        -format s \
        -sync)

    [[ -n "$choice" ]] || exit 0
    choice="${choice#? }"
    load_theme "$choice"
    apply_all
}

case "${1:-menu}" in
    apply)
        if [[ $# -ne 2 ]]; then usage >&2; exit 2; fi
        load_theme "$2"
        apply_all
        ;;
    menu)
        menu
        ;;
    current)
        current_theme
        ;;
    list)
        list_themes
        ;;
    -h|--help|help)
        usage
        ;;
    *)
        usage >&2
        exit 2
        ;;
esac
