  // BEGIN dotfiles-theme
  "workbench.colorCustomizations": {
    "activityBar.background": "$bg",
    "activityBar.foreground": "$fg",
    "activityBarBadge.background": "$accent",
    "activityBarBadge.foreground": "$bg",
    "statusBar.background": "$bg",
    "statusBar.foreground": "$fg",
    "statusBarItem.remoteBackground": "$accent",
    "statusBarItem.remoteForeground": "$bg",
    "titleBar.activeBackground": "$bg",
    "titleBar.activeForeground": "$fg",
    "editor.background": "$bg",
    "editor.foreground": "$fg",
    "editorCursor.foreground": "$accent",
    "editor.selectionBackground": "$muted",
    "sideBar.background": "$bg",
    "sideBar.foreground": "$fg",
    "terminal.background": "$bg",
    "terminal.foreground": "$fg"
  },
  // END dotfiles-theme
VSCODE_BLOCK

    awk -v block_file="$block" '
        BEGIN {
            while ((getline line < block_file) > 0) block = block line ORS
            close(block_file)
        }
        /^[[:space:]]*\/\/ BEGIN dotfiles-theme/ { printf "%s", block; skip = 1; inserted = 1; next }
        skip && /^[[:space:]]*\/\/ END dotfiles-theme/ { skip = 0; next }
        skip { next }
        !inserted && /^[[:space:]]*\{/ { print; printf "%s", block; inserted = 1; next }
        { print }
    ' "$settings" > "$tmp" && mv "$tmp" "$settings"
    rm -f "$block" "$tmp"
}

apply_ly() {
    local dest="$config_dir/ly/theme.ini"
    mkdir -p "$(dirname "$dest")"

    cat > "$dest" <<LY
# Generated by theme-switch from $theme_name
bg = 0x00${bg#\#}
fg = 0x00${fg#\#}
border_fg = 0x00${accent#\#}
error_fg = 0x01${critical#\#}
colormix_col1 = 0x00${accent#\#}
colormix_col2 = 0x00${bg#\#}
colormix_col3 = 0x00${accent_alt#\#}
LY
}

apply_shell() {
    local dest="$config_dir/shell/theme.sh"
    mkdir -p "$(dirname "$dest")"

    cat > "$dest" <<SHELL_THEME
# Generated by theme-switch from $theme_name
export DOTFILES_THEME="$theme_name"
export DOTFILES_THEME_BG="$bg"
export DOTFILES_THEME_FG="$fg"
export DOTFILES_THEME_MUTED="$muted"
export DOTFILES_THEME_ACCENT="$accent"
export DOTFILES_THEME_ACCENT_ALT="$accent_alt"
export DOTFILES_THEME_WARM="$warm"
export DOTFILES_THEME_OK="$ok"
export DOTFILES_THEME_CRITICAL="$critical"
SHELL_THEME
}

apply_all() {
    apply_waybar
    apply_rofi
    apply_gtk
    apply_swaync
    apply_hyprlock
    apply_wlogout
    apply_wob
    apply_swayosd
    apply_alacritty
    apply_qt
    apply_vscode
    apply_ly
    apply_shell
    save_state
}

theme_thumbnail() {
    local name="$1"
    local conf="$themes_dir/${name}.conf"
    local cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/theme-thumbnails"
    local thumb="$cache_dir/${name}.svg"

    [[ -f "$conf" ]] || return 1
    mkdir -p "$cache_dir"

    if [[ ! -f "$thumb" || "$conf" -nt "$thumb" ]]; then
        local waybar_palette waybar_base waybar_shape waybar_accent gtk_theme
        local bg fg muted accent accent_alt warm ok critical
        source "$conf"
        cat > "$thumb" <<SVG
<svg xmlns="http://www.w3.org/2000/svg" width="256" height="160" viewBox="0 0 256 160">
  <rect width="256" height="160" rx="16" fill="$bg"/>
  <rect x="16" y="14" width="224" height="18" rx="8" fill="$muted" opacity="0.55"/>
  <circle cx="30" cy="23" r="5" fill="$accent"/>
  <rect x="48" y="19" width="34" height="8" rx="4" fill="$accent_alt"/>
  <rect x="92" y="19" width="48" height="8" rx="4" fill="$warm"/>
  <rect x="176" y="19" width="24" height="8" rx="4" fill="$ok"/>
  <rect x="208" y="19" width="18" height="8" rx="4" fill="$critical"/>
  <rect x="24" y="52" width="92" height="58" rx="14" fill="$accent" opacity="0.9"/>
  <rect x="132" y="52" width="52" height="58" rx="14" fill="$accent_alt" opacity="0.9"/>
  <rect x="196" y="52" width="36" height="58" rx="14" fill="$warm" opacity="0.9"/>
  <rect x="24" y="124" width="208" height="8" rx="4" fill="$fg" opacity="0.85"/>
  <rect x="24" y="140" width="124" height="6" rx="3" fill="$muted"/>
</svg>
SVG
    fi

    printf '%s\n' "$thumb"
}

menu() {
    ensure_generated

    if pidof rofi >/dev/null 2>&1; then
        pkill rofi
        exit 0
    fi

    local cur choice selected_row=0 i=0
    cur="$(current_theme)"

    while read -r name; do
        if [[ "$name" == "$cur" ]]; then
            selected_row="$i"
            break
        fi
        i=$((i + 1))
    done < <(list_themes)

    choice=$(list_themes | while read -r name; do
        thumb="$(theme_thumbnail "$name" || printf 'preferences-desktop-theme')"
        if [[ "$name" == "$cur" ]]; then
            printf '[ %s ]\0icon\x1f%s\n' "$name" "$thumb"
        else
            printf '%s\0icon\x1f%s\n' "$name" "$thumb"
        fi
    done | rofi -dmenu \
        -i \
        -no-custom \
        -show-icons \
        -p "Theme" \
        -selected-row "$selected_row" \
        -theme-str 'configuration { font: "JetBrainsMono ExtraBold 11"; cycle: false; } window { width: 38%; } listview { columns: 1; lines: 12; } element { padding: 4px 6px; } element-icon { size: 2.2em; }' \
        -format s \
        -sync)

    [[ -n "$choice" ]] || exit 0
    choice="${choice#[ }"
    choice="${choice% ]}"
    load_theme "$choice"
    apply_all
}

case "${1:-menu}" in
    apply)
        if [[ $# -ne 2 ]]; then usage >&2; exit 2; fi
        load_theme "$2"
        apply_all
        ;;
    menu)
        menu
        ;;
    current)
        current_theme
        ;;
    list)
        list_themes
        ;;
    -h|--help|help)
        usage
        ;;
    *)
        usage >&2
        exit 2
        ;;
esac
