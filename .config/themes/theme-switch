#!/usr/bin/env bash
set -euo pipefail

# -----------------------------------------------------------------------------
# Bootstrap
# -----------------------------------------------------------------------------

themes_dir="$HOME/.config/themes"
state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/themes"
state_file="$state_dir/current"
config_dir="$HOME/.config"
lib_file="$config_dir/dotfiles/lib.sh"
[ -r "$lib_file" ] && . "$lib_file"
type dotfiles_load_machine_config >/dev/null 2>&1 && dotfiles_load_machine_config

# -----------------------------------------------------------------------------
# CLI
# -----------------------------------------------------------------------------

usage() {
    printf 'Usage: %s [apply THEME|menu|current|list]\n' "$(basename "$0")"
}

# -----------------------------------------------------------------------------
# Theme State
# -----------------------------------------------------------------------------

load_theme() {
    local name="$1"
    local conf="$themes_dir/${name}.conf"
    if [[ ! -f "$conf" ]]; then
        printf 'No such theme: %s\n' "$name" >&2
        exit 1
    fi
    unset gtk_surface gtk_sidebar gtk_header
    source "$conf"
    theme_mode="${theme_mode:-dark}"
    gtk_surface="${gtk_surface:-$(blend_hex "$(blend_hex "$bg" "$muted" 18)" "$accent" 10)}"
    gtk_sidebar="${gtk_sidebar:-$(blend_hex "$(blend_hex "$bg" "$muted" 12)" "$accent" 7)}"
    gtk_header="${gtk_header:-$(blend_hex "$(blend_hex "$bg" "$muted" 8)" "$accent" 5)}"
    case "$theme_mode" in
        dark|light) ;;
        *)
            printf 'Invalid theme_mode in %s: %s (expected dark or light)\n' "$conf" "$theme_mode" >&2
            exit 1
            ;;
    esac
    theme_name="$name"
}

save_state() {
    mkdir -p "$state_dir"
    printf '%s\n' "$theme_name" > "$state_file"
}

current_theme() {
    if [[ -f "$state_file" ]]; then
        cat "$state_file"
    fi
}

default_theme() {
    local cur
    cur="$(current_theme)"
    if [[ -n "$cur" && -f "$themes_dir/${cur}.conf" ]]; then
        printf '%s\n' "$cur"
        return
    fi

    if [[ -f "$themes_dir/tokyo-night.conf" ]]; then
        printf '%s\n' "tokyo-night"
        return
    fi

    list_themes | sed -n '1p'
}

list_themes() {
    shopt -s nullglob
    for f in "$themes_dir"/*.conf; do
        basename "$f" .conf
    done | sort
    shopt -u nullglob
}

# -----------------------------------------------------------------------------
# Shared Helpers
# -----------------------------------------------------------------------------

systemd_user_active() {
    systemctl --user --quiet is-active "$1" 2>/dev/null
}

restart_user_service() {
    systemctl --user restart "$1" 2>/dev/null || true
}

hex_to_rgb() {
    local hex="${1#\#}"
    printf '%d %d %d\n' "0x${hex:0:2}" "0x${hex:2:2}" "0x${hex:4:2}"
}

hex_to_rgb_csv() {
    local hex="${1#\#}"
    printf '%d,%d,%d\n' "0x${hex:0:2}" "0x${hex:2:2}" "0x${hex:4:2}"
}

blend_hex() {
    local base="${1#\#}"
    local tint="${2#\#}"
    local tint_pct="$3"
    local base_pct=$((100 - tint_pct))
    local br bgc bb tr tg tb r g b

    br=$((16#${base:0:2}))
    bgc=$((16#${base:2:2}))
    bb=$((16#${base:4:2}))
    tr=$((16#${tint:0:2}))
    tg=$((16#${tint:2:2}))
    tb=$((16#${tint:4:2}))

    r=$(((br * base_pct + tr * tint_pct) / 100))
    g=$(((bgc * base_pct + tg * tint_pct) / 100))
    b=$(((bb * base_pct + tb * tint_pct) / 100))
    printf '#%02x%02x%02x\n' "$r" "$g" "$b"
}

portal_color_scheme() {
    case "$theme_mode" in
        light) printf 'prefer-light\n' ;;
        *) printf 'prefer-dark\n' ;;
    esac
}

hex_to_hypr() {
    local hex="${1#\#}"
    printf '0xff%s\n' "$hex"
}

hex_to_alpha() {
    local hex="${1#\#}"
    printf 'ff%s\n' "$hex"
}

hex_to_qt() {
    local hex="${1#\#}"
    printf '#ff%s\n' "$hex"
}

hex_to_qt_dim() {
    local hex="${1#\#}"
    printf '#80%s\n' "$hex"
}

# -----------------------------------------------------------------------------
# Generated File Health
# -----------------------------------------------------------------------------

generated_missing() {
    local files=(
        "$config_dir/rofi/theme.rasi"
        "$config_dir/rofi/wallpaper-theme.rasi"
        "$config_dir/rofi/clipboard-theme.rasi"
        "$config_dir/gtk-3.0/gtk.css"
        "$config_dir/gtk-4.0/gtk.css"
        "$config_dir/swaync/style.css"
        "$config_dir/hypr/hyprlock-theme.conf"
        "$config_dir/wlogout/style.css"
        "$config_dir/wob/wob.ini"
        "$config_dir/swayosd/style.css"
        "$config_dir/alacritty/theme.toml"
        "$config_dir/kdeglobals"
        "${XDG_DATA_HOME:-$HOME/.local/share}/color-schemes/Dotfiles.colors"
        "$config_dir/qt5ct/colors/dotfiles.conf"
        "$config_dir/qt6ct/colors/dotfiles.conf"
        "$config_dir/qt5ct/qt5ct.conf"
        "$config_dir/qt6ct/qt6ct.conf"
        "$config_dir/qt6ct/dotfiles.qss"
        "${XDG_DATA_HOME:-$HOME/.local/share}/dolphin/view_properties/global/.directory"
        "$config_dir/ly/theme.ini"
        "$config_dir/shell/theme.sh"
        "${XDG_CACHE_HOME:-$HOME/.cache}/waybar/theme.css"
    )

    local file
    for file in "${files[@]}"; do
        [[ -s "$file" ]] || return 0
    done

    return 1
}

ensure_generated() {
    generated_missing || return 0

    local theme
    theme="$(default_theme)"
    if [[ -z "$theme" ]]; then
        printf 'No themes found in %s\n' "$themes_dir" >&2
        exit 1
    fi

    load_theme "$theme"
    apply_all
}

# -----------------------------------------------------------------------------
# Apply: Desktop Shell
# -----------------------------------------------------------------------------

apply_waybar() {
    local cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/waybar"
    local waybar_state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/waybar"
    local generated_config="$cache_dir/config"
    mkdir -p "$cache_dir" "$waybar_state_dir"

    cat > "$waybar_state_dir/theme.conf" <<EOF
base=$waybar_base
palette=$waybar_palette
shape=$waybar_shape
accent=$waybar_accent
EOF

    cat > "$cache_dir/theme.css" <<EOF
/* Generated by theme-switch from $theme_name */
@import "$config_dir/waybar/themes/palette/$waybar_palette.css";
@import "$config_dir/waybar/themes/base/$waybar_base.css";
@import "$config_dir/waybar/themes/shape/$waybar_shape.css";
@import "$config_dir/waybar/themes/accent/$waybar_accent.css";

/* Keep tray context menus readable even when the bar theme resets all GTK
   backgrounds to transparent. */
menu,
menu.background,
window.popup,
popover,
popover.background,
popover.menu,
popover > contents,
popover.menu > contents {
    background: @bg;
    background-color: @bg;
    background-image: none;
    color: @fg;
    opacity: 1;
}

menu menuitem,
menuitem,
popover.menu modelbutton {
    background: @bg;
    background-color: @bg;
    background-image: none;
    color: @fg;
}

menu menuitem:hover,
menuitem:hover,
popover.menu modelbutton:hover {
    background: @accent;
    background-color: @accent;
    background-image: none;
    color: @bg;
}
EOF

    awk \
        -v months="        \"months\": \"<span color='$accent'><b>{}</b></span>\"," \
        -v days="        \"days\": \"<span color='$accent_alt'><b>{}</b></span>\"," \
        -v weeks="        \"weeks\": \"<span color='$ok'><b>W{}</b></span>\"," \
        -v weekdays="        \"weekdays\": \"<span color='$warm'><b>{}</b></span>\"," \
        -v today="        \"today\": \"<span color='$critical'><b><u>{}</u></b></span>\"" \
        '
        /"months"[[:space:]]*:/ { print months; next }
        /"days"[[:space:]]*:/ { print days; next }
        /"weeks"[[:space:]]*:/ { print weeks; next }
        /"weekdays"[[:space:]]*:/ { print weekdays; next }
        /"today"[[:space:]]*:/ { print today; next }
        { print }
        ' "$config_dir/waybar/config" > "$generated_config"

    ln -sf "$cache_dir/theme.css" "$config_dir/waybar/style.css"
    if systemd_user_active waybar.service; then
        restart_user_service waybar.service
    else
        killall waybar 2>/dev/null || true
        nohup "$config_dir/waybar/scripts/statusbar" >/dev/null 2>&1 &
    fi
}

apply_rofi() {
    local bg_r bg_g bg_b
    read -r bg_r bg_g bg_b < <(hex_to_rgb "$bg")
    local bg_rgba="rgba(${bg_r}, ${bg_g}, ${bg_b}, 93%)"
    local window_radius input_radius element_radius

    case "$waybar_shape" in
        zero-bar|omarchy-tight|hairline-blocks)
            window_radius=0
            input_radius=0
            element_radius=0
            ;;
        compact-pills|soft-islands)
            window_radius=16
            input_radius=12
            element_radius=12
            ;;
        *)
            window_radius=8
            input_radius=5
            element_radius=4
            ;;
    esac

    for target in theme wallpaper-theme clipboard-theme; do
        local dest="$config_dir/rofi/${target}.rasi"
        cat > "$dest" <<ROFI
* {
  bg:               ${bg_rgba};
  bg-input:         ${muted};
  fg:               ${fg};
  fg-selected:      ${bg};
  accent1:          ${accent};
  accent2:          ${accent_alt};
  urgent:           ${critical};
  border-clr:       ${muted};
  separator-clr:    ${muted};

  background-color: transparent;
  text-color:       var(fg);
  spacing:          4;
}

window {
  background-color: var(bg);
  border:           2px;
  border-color:     var(border-clr);
  border-radius:    ${window_radius}px;
  padding:          12px;
  width:            46%;
}

mainbox {
  padding: 0;
}

inputbar {
  background-color: var(bg-input);
  border:           1px;
  border-color:     var(border-clr);
  border-radius:    ${input_radius}px;
  padding:          8px 12px;
  margin:           0px 0px 8px 0px;
  children:         [prompt, entry];
}

prompt {
  text-color: var(accent1);
  margin:    0px 8px 0px 0px;
}

entry {
  text-color: var(fg);
}

listview {
  padding:      4px 0px;
  scrollbar:    true;
  spacing:      2px;
  fixed-height: false;
  lines:        14;
  columns:      1;
}

scrollbar {
  width:            4px;
  padding:          0;
  handle-width:     8px;
  handle-color:     var(accent1);
  border:           0px;
  background-color: transparent;
}

element {
  padding:       6px 8px;
  border-radius: ${element_radius}px;
  spacing:       8px;
}

element normal normal {
  background-color: transparent;
  text-color:       var(fg);
}

element normal urgent {
  background-color: transparent;
  text-color:       var(urgent);
}

element normal active {
  background-color: transparent;
  text-color:       var(accent1);
}

element selected normal {
  background-image: linear-gradient(to right, ${accent}, ${accent_alt});
  text-color:       var(fg-selected);
}

element selected urgent {
  background-image: linear-gradient(to right, ${critical}, ${accent_alt});
  text-color:       var(fg-selected);
}

element selected active {
  background-image: linear-gradient(to right, ${accent}, ${accent_alt});
  text-color:       var(fg-selected);
}

element alternate normal {
  background-color: transparent;
  text-color:       var(fg);
}

element alternate urgent {
  background-color: transparent;
  text-color:       var(urgent);
}

element alternate active {
  background-color: transparent;
  text-color:       var(accent1);
}

element-icon {
  background-color: transparent;
  size:             1.2em;
}

element selected normal element-icon {
  size: 3.6em;
}

element selected urgent element-icon {
  size: 3.6em;
}

element selected active element-icon {
  size: 3.6em;
}

element-text {
  background-color: transparent;
  text-color:       inherit;
  highlight:        inherit;
}

message {
  padding:      4px;
  border-color: var(separator-clr);
  border:       2px dash 0px 0px;
}

textbox {
  text-color: var(fg);
}

mode-switcher {
  margin:  8px 0px 0px 0px;
  spacing: 4px;
}

button {
  padding:       4px 12px;
  border-radius: ${element_radius}px;
  text-color:    var(fg);
}

button selected {
  background-image: linear-gradient(to right, ${accent}, ${accent_alt});
  text-color:       var(fg-selected);
}

error-message {
  background-color: var(bg);
  text-color:       var(urgent);
  padding:          12px;
  border-radius:    ${window_radius}px;
}
