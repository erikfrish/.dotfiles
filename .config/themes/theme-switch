apply_wob() {
    local wob_conf="$config_dir/wob/wob.ini"
    local bg_hex="${bg#\#}"
    local accent_hex="${accent#\#}"
    local muted_hex="${muted#\#}"

    mkdir -p "$(dirname "$wob_conf")"

    cat > "$wob_conf" <<WOB
timeout = 1000
width = 600
height = 40
border_offset = 2
border_size = 2
bar_padding = 2
anchor = top center
margin = 55
background_color = ${bg_hex}ee
bar_color = ${accent_hex}
border_color = ${accent_hex}
[style.muted]
bar_color = ${muted_hex}
border_color = ${muted_hex}
[style.overflow]
bar_color = ${critical#\#}
border_color = ${critical#\#}
background_color = ${bg_hex}ee
WOB

    if systemd_user_active wob.service; then
        restart_user_service wob.service
    else
        local fifo
        if type dotfiles_wob_fifo >/dev/null 2>&1; then
            fifo=$(dotfiles_wob_fifo)
        else
            fifo="${XDG_RUNTIME_DIR:-/tmp}/niri.wob"
        fi
        pkill -f "wob -c" 2>/dev/null || true
        pkill -f "tail -f $fifo" 2>/dev/null || true
        sleep 0.1
        rm -f "$fifo"
        mkfifo "$fifo"
        nohup sh -c 'tail -f "$1" | wob -c "$2"' sh "$fifo" "$wob_conf" >/dev/null 2>&1 &
    fi
}

