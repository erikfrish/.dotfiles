#!/usr/bin/env bash
set -euo pipefail

themes_dir="$HOME/.config/themes"
state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/themes"
state_file="$state_dir/current"
config_dir="$HOME/.config"
lib_file="$config_dir/dotfiles/lib.sh"
[ -r "$lib_file" ] && . "$lib_file"
type dotfiles_load_machine_config >/dev/null 2>&1 && dotfiles_load_machine_config

usage() {
    printf 'Usage: %s [apply THEME|menu|current|list]\n' "$(basename "$0")"
}

load_theme() {
    local name="$1"
    local conf="$themes_dir/${name}.conf"
    if [[ ! -f "$conf" ]]; then
        printf 'No such theme: %s\n' "$name" >&2
        exit 1
    fi
    source "$conf"
    theme_name="$name"
}

save_state() {
    mkdir -p "$state_dir"
    printf '%s\n' "$theme_name" > "$state_file"
}

current_theme() {
    if [[ -f "$state_file" ]]; then
        cat "$state_file"
    fi
}

default_theme() {
    local cur
    cur="$(current_theme)"
    if [[ -n "$cur" && -f "$themes_dir/${cur}.conf" ]]; then
        printf '%s\n' "$cur"
        return
    fi

    if [[ -f "$themes_dir/tokyo-night.conf" ]]; then
        printf '%s\n' "tokyo-night"
        return
    fi

    list_themes | sed -n '1p'
}

list_themes() {
    shopt -s nullglob
    for f in "$themes_dir"/*.conf; do
        basename "$f" .conf
    done | sort
    shopt -u nullglob
}

generated_missing() {
    local files=(
        "$config_dir/rofi/theme.rasi"
        "$config_dir/rofi/wallpaper-theme.rasi"
        "$config_dir/rofi/clipboard-theme.rasi"
        "$config_dir/gtk-3.0/gtk.css"
        "$config_dir/gtk-4.0/gtk.css"
        "$config_dir/swaync/style.css"
        "$config_dir/hypr/hyprlock-theme.conf"
        "$config_dir/wlogout/style.css"
        "$config_dir/wob/wob.ini"
        "$config_dir/swayosd/style.css"
        "$config_dir/alacritty/theme.toml"
        "$config_dir/ly/theme.ini"
        "$config_dir/shell/theme.sh"
        "${XDG_CACHE_HOME:-$HOME/.cache}/waybar/theme.css"
    )

    local file
    for file in "${files[@]}"; do
        [[ -s "$file" ]] || return 0
    done

    return 1
}

ensure_generated() {
    generated_missing || return 0

    local theme
    theme="$(default_theme)"
    if [[ -z "$theme" ]]; then
        printf 'No themes found in %s\n' "$themes_dir" >&2
        exit 1
    fi

    load_theme "$theme"
    apply_all
}

hex_to_rgb() {
    local hex="${1#\#}"
    printf '%d %d %d\n' "0x${hex:0:2}" "0x${hex:2:2}" "0x${hex:4:2}"
}

hex_to_hypr() {
    local hex="${1#\#}"
    printf '0xff%s\n' "$hex"
}

hex_to_alpha() {
    local hex="${1#\#}"
    printf 'ff%s\n' "$hex"
}

apply_waybar() {
    local cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/waybar"
    local waybar_state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/waybar"
    mkdir -p "$cache_dir" "$waybar_state_dir"

    cat > "$waybar_state_dir/theme.conf" <<EOF
base=$waybar_base
palette=$waybar_palette
shape=$waybar_shape
accent=$waybar_accent
EOF

    cat > "$cache_dir/theme.css" <<EOF
/* Generated by theme-switch from $theme_name */
@import "$config_dir/waybar/themes/palette/$waybar_palette.css";
@import "$config_dir/waybar/themes/base/$waybar_base.css";
@import "$config_dir/waybar/themes/shape/$waybar_shape.css";
@import "$config_dir/waybar/themes/accent/$waybar_accent.css";
EOF

    ln -sf "$cache_dir/theme.css" "$config_dir/waybar/style.css"
    if systemctl --user --quiet is-active waybar.service 2>/dev/null; then
        systemctl --user restart waybar.service 2>/dev/null || true
    else
        killall waybar 2>/dev/null || true
        nohup "$config_dir/waybar/scripts/statusbar" >/dev/null 2>&1 &
    fi
}

apply_rofi() {
    local bg_r bg_g bg_b
    read -r bg_r bg_g bg_b < <(hex_to_rgb "$bg")
    local bg_rgba="rgba(${bg_r}, ${bg_g}, ${bg_b}, 93%)"
    local window_radius input_radius element_radius

    case "$waybar_shape" in
        zero-bar|omarchy-tight|hairline-blocks)
            window_radius=0
            input_radius=0
            element_radius=0
            ;;
        compact-pills|soft-islands)
            window_radius=16
            input_radius=12
            element_radius=12
            ;;
        *)
            window_radius=8
            input_radius=5
            element_radius=4
            ;;
    esac

    for target in theme wallpaper-theme clipboard-theme; do
        local dest="$config_dir/rofi/${target}.rasi"
        cat > "$dest" <<ROFI
* {
  bg:               ${bg_rgba};
  bg-input:         ${muted};
  fg:               ${fg};
  fg-selected:      ${bg};
  accent1:          ${accent};
  accent2:          ${accent_alt};
  urgent:           ${critical};
  border-clr:       ${muted};
  separator-clr:    ${muted};

  background-color: transparent;
  text-color:       var(fg);
  spacing:          4;
}

window {
  background-color: var(bg);
  border:           2px;
  border-color:     var(border-clr);
  border-radius:    ${window_radius}px;
  padding:          12px;
  width:            46%;
}

mainbox {
  padding: 0;
}

inputbar {
  background-color: var(bg-input);
  border:           1px;
  border-color:     var(border-clr);
  border-radius:    ${input_radius}px;
  padding:          8px 12px;
  margin:           0px 0px 8px 0px;
  children:         [prompt, entry];
}

prompt {
  text-color: var(accent1);
  margin:    0px 8px 0px 0px;
}

entry {
  text-color: var(fg);
}

listview {
  padding:      4px 0px;
  scrollbar:    true;
  spacing:      2px;
  fixed-height: false;
  lines:        14;
  columns:      1;
}

scrollbar {
  width:            4px;
  padding:          0;
  handle-width:     8px;
  handle-color:     var(accent1);
  border:           0px;
  background-color: transparent;
}

element {
  padding:       6px 8px;
  border-radius: ${element_radius}px;
  spacing:       8px;
}

element normal normal {
  background-color: transparent;
  text-color:       var(fg);
}

element normal urgent {
  background-color: transparent;
  text-color:       var(urgent);
}

element normal active {
  background-color: transparent;
  text-color:       var(accent1);
}

element selected normal {
  background-image: linear-gradient(to right, ${accent}, ${accent_alt});
  text-color:       var(fg-selected);
}

element selected urgent {
  background-image: linear-gradient(to right, ${critical}, ${accent_alt});
  text-color:       var(fg-selected);
}

element selected active {
  background-image: linear-gradient(to right, ${accent}, ${accent_alt});
  text-color:       var(fg-selected);
}

element alternate normal {
  background-color: transparent;
  text-color:       var(fg);
}

element alternate urgent {
  background-color: transparent;
  text-color:       var(urgent);
}

element alternate active {
  background-color: transparent;
  text-color:       var(accent1);
}

element-icon {
  background-color: transparent;
  size:             1.2em;
}

element-text {
  background-color: transparent;
  text-color:       inherit;
  highlight:        inherit;
}

message {
  padding:      4px;
  border-color: var(separator-clr);
  border:       2px dash 0px 0px;
}

textbox {
  text-color: var(fg);
}

mode-switcher {
  margin:  8px 0px 0px 0px;
  spacing: 4px;
}

button {
  padding:       4px 12px;
  border-radius: ${element_radius}px;
  text-color:    var(fg);
}

button selected {
  background-image: linear-gradient(to right, ${accent}, ${accent_alt});
  text-color:       var(fg-selected);
}

error-message {
  background-color: var(bg);
  text-color:       var(urgent);
  padding:          12px;
  border-radius:    ${window_radius}px;
}
ROFI
    done

    cat >> "$config_dir/rofi/wallpaper-theme.rasi" <<'WALLPAPER_ROFI'

window {
  width:   62%;
  padding: 16px;
}

listview {
  columns: 2;
  lines:   3;
  spacing: 6px;
  flow:    horizontal;
}

element {
  orientation: vertical;
  padding:     8px;
  spacing:     6px;
}

element-icon {
  size: 8em;
}

element-text {
  horizontal-align: 0.5;
}
WALLPAPER_ROFI
}

apply_gtk() {
    gsettings set org.gnome.desktop.interface gtk-theme "$gtk_theme" 2>/dev/null || true
    gsettings set org.gnome.desktop.interface color-scheme 'prefer-dark' 2>/dev/null || true

    local gtk3_css="$config_dir/gtk-3.0/gtk.css"
    local gtk4_css="$config_dir/gtk-4.0/gtk.css"

    for css_file in "$gtk3_css" "$gtk4_css"; do
        cat > "$css_file" <<GTKCSS
/* Generated by theme-switch from $theme_name */
@define-color theme_fg_color ${fg};
@define-color theme_bg_color ${bg};
@define-color theme_selected_bg_color ${accent};
@define-color theme_selected_fg_color ${bg};
@define-color theme_unfocused_fg_color ${muted};
@define-color theme_unfocused_bg_color ${bg};
GTKCSS
    done
}

apply_swaync() {
    local template="$config_dir/swaync/template.css"
    local style="$config_dir/swaync/style.css"
    local control_radius bubble_radius widget_radius
    if [[ ! -f "$template" ]]; then
        return
    fi

    case "$waybar_shape" in
        zero-bar|omarchy-tight|hairline-blocks)
            control_radius=0
            bubble_radius=0
            widget_radius=0
            ;;
        compact-pills|soft-islands)
            control_radius=18
            bubble_radius=16
            widget_radius=14
            ;;
        *)
            control_radius=10
            bubble_radius=8
            widget_radius=8
            ;;
    esac

    {
        cat <<COLORS
@define-color cc-bg ${bg};
@define-color noti-border-color ${fg};
@define-color noti-bg ${bg};
@define-color noti-bg-darker ${muted};
@define-color noti-bg-hover ${muted};
@define-color noti-bg-focus ${bg};
@define-color noti-close-bg ${fg};
@define-color noti-close-bg-hover ${fg};
@define-color text-color ${fg};
@define-color text-color-disabled ${muted};
@define-color bg-selected ${accent};
@define-color border-green ${ok};
@define-color border-blue ${accent};
@define-color red-base ${critical};
@define-color red-hover ${critical};
@define-color green-base ${ok};
@define-color blue-base ${accent};
COLORS
        tail -n +2 "$template"
        cat <<RADIUS

.control-center {
  border-radius: ${control_radius}px;
}

.notification,
.notification-content,
.notification-action,
.notification-default-action,
.inline-reply-entry,
.inline-reply-button,
.close-button {
  border-radius: ${bubble_radius}px;
}

.widget-title,
.widget-title>button,
.widget-dnd,
.widget-dnd>switch,
.widget-dnd>switch slider,
.widget-buttons-grid,
.widget-buttons-grid>flowbox>flowboxchild>button,
.widget-volume,
.widget-backlight,
.widget-mpris,
.widget-mpris-player,
.widget-mpris-album-art {
  border-radius: ${widget_radius}px;
}
RADIUS
    } > "$style"
    swaync-client --reload-css 2>/dev/null || killall -HUP swaync 2>/dev/null || true
}

