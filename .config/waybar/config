    "on-scroll-up": "~/.config/desktop/scripts/brightness --inc",
    "on-scroll-down": "~/.config/desktop/scripts/brightness --dec",
    "smooth-scrolling-threshold": 1,
    "signal": 10,
  },

  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "", // "☕" "󱐋"
      "deactivated": "", // "💤" "󰛩"

    },
    "tooltip": "true",
  },

