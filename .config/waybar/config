  //     "format": "{temperatureC}°C {icon}",
  //     "format-icons": [""],
  //     "on-click-right": "alacritty --title btop -e btop"
  //   },

  "memory": {
    "interval": 10,
    // "format": "  {used:0.2f} / {total:0.0f} GB",
    "format": "{used:0.1f}G 󰘚",
    "on-click": "alacritty -e btop",
  },

  "custom/menu": {
    "format": "", // "",
    "tooltip": false,
    "on-click": "$HOME/.config/desktop/scripts/menu",
    "on-click-right": "$HOME/.config/hypr/scripts/layout-switcher",
  },

  // "battery": {
  //   "interval": 2,
  //   "states": {
  //     "good": 95,
  //     "warning": 30,
  //     "critical": 15,
  //   },
