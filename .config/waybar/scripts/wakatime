#!/bin/bash

# Получаем полный вывод
raw_stats=$(wakatime-cli --today 2>/dev/null | xargs)

if [ -z "$raw_stats" ] || [ "$raw_stats" == "0 secs" ]; then
    echo "{\"text\": \"0m\", \"tooltip\": \"Нет данных\"}"
    exit 0
fi

# Вытаскиваем только время кодинга (все до первой запятой)
# Например из "4 hrs 39 mins coding, 0 hrs 3 mins..." сделает "4h 39m"
coding_time=$(echo "$raw_stats" | cut -d',' -f1 | sed 's/ hrs/h/g; s/ mins/m/g; s/ coding//g')

# Получаем детальную разбивку для тултипа (проекты и языки)
details=$(wakatime-cli --today --hide-filenames --output brief 2>/dev/null | sed ':a;N;$!ba;s/\n/\\n/g' | sed 's/"/\\"/g')

# Собираем JSON
echo "{\"text\": \"$coding_time\", \"tooltip\": \"Общее время: $raw_stats\\n\\nДетали по проектам:\\n$details\"}"
