// -----------------------------------------------------------------------------
// Autostart
// -----------------------------------------------------------------------------

// Core session services and tray applets.
spawn-at-startup "xwayland-satellite"
spawn-sh-at-startup "~/.config/desktop/scripts/fix-xkb-wayland"
spawn-at-startup "fcitx5" "-d"
spawn-at-startup "nm-applet" "--indicator"
spawn-at-startup "blueman-applet"

// Authentication prompts for privileged actions such as fingerprint enrollment.
spawn-sh-at-startup "systemctl --user start plasma-polkit-agent.service"

// Import the session environment before starting shared user services.
spawn-sh-at-startup "dbus-update-activation-environment --systemd SSH_AUTH_SOCK XDG_RUNTIME_DIR WAYLAND_DISPLAY DISPLAY XDG_CURRENT_DESKTOP GTK_THEME QT_QPA_PLATFORMTHEME && systemctl --user daemon-reload && systemctl --user start gammastep.service swaync.service dotfiles-session.target"

// OSD helper for layout/Caps Lock notifications.
spawn-sh-at-startup "~/.config/desktop/scripts/lang_switch_osd"

// Low battery notifier
spawn-sh-at-startup "~/.config/desktop/scripts/battery_notify"

// Niri-specific helpers.
spawn-sh-at-startup "~/.config/niri/scripts/niri_pip_sticky"

// Session apps: browser on workspace 1, IDE on 2, chats on 3.
spawn-sh-at-startup "~/.config/niri/scripts/niri_autostart_apps"
