binds {
    Mod+Shift+Slash { show-hotkey-overlay; }

    Mod+I hotkey-overlay-title="Open VSCode" { spawn "code"; }
    Mod+O hotkey-overlay-title="Open Overview" { toggle-overview; }
    Mod+T hotkey-overlay-title="Open Terminal" { spawn "kitty"; }
    Mod+E hotkey-overlay-title="Open Files" { spawn "nautilus"; }
    Mod+R hotkey-overlay-title="Open Menu" { spawn-sh "~/.config/hypr/scripts/menu"; }

    Mod+Q { close-window; }
    Mod+V { toggle-window-floating; }
    Mod+Shift+V { switch-focus-between-floating-and-tiling; }
    Mod+F { fullscreen-window; }
    Mod+Ctrl+F { maximize-column; }
    Mod+BracketRight { consume-or-expel-window-right; }
    Mod+BracketLeft { consume-or-expel-window-left; }

    Mod+P { spawn "hyprpicker" "-a"; }
    Mod+W { spawn-sh "~/.config/hypr/scripts/waybar_style_change"; }
    Mod+B { spawn-sh "killall waybar || waybar &"; }
    Mod+C { spawn-sh "~/.config/hypr/scripts/clipboard_history"; }

    XF86AudioRaiseVolume allow-when-locked=true { spawn-sh "~/.config/hypr/scripts/volume --inc"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn-sh "~/.config/hypr/scripts/volume --dec"; }
    XF86AudioMute allow-when-locked=true { spawn-sh "~/.config/hypr/scripts/volume --toggle"; }
    XF86AudioMicMute allow-when-locked=true { spawn-sh "~/.config/hypr/scripts/volume --toggle-mic"; }

    XF86MonBrightnessUp allow-when-locked=true { spawn-sh "brightnessctl -e4 -n2 set 5%+ | sed -En 's/.*\\( ([0-9]+)%\\).*/\\1/p' > /tmp/niri.wob"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn-sh "brightnessctl -e4 -n2 set 5%- | sed -En 's/.*\\( ([0-9]+)%\\).*/\\1/p' > /tmp/niri.wob"; }

    XF86AudioPlay allow-when-locked=true { spawn-sh "playerctl play-pause"; }
    XF86AudioPause allow-when-locked=true { spawn-sh "playerctl play-pause"; }
    XF86AudioNext allow-when-locked=true { spawn-sh "playerctl next"; }
    XF86AudioPrev allow-when-locked=true { spawn-sh "playerctl previous"; }

    Mod+Left { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Up { focus-window-up; }
    Mod+Down { focus-window-down; }
    Mod+H { focus-column-left; }
    Mod+L { focus-column-right; }
    Mod+K { focus-window-up; }
    Mod+J { focus-window-down; }

    Mod+Shift+Left { move-column-left; }
    Mod+Shift+Right { move-column-right; }
    Mod+Shift+Up { move-window-up; }
    Mod+Shift+Down { move-window-down; }
    Mod+Shift+H { move-column-left; }
    Mod+Shift+L { move-column-right; }
    Mod+Shift+K { move-window-up; }
    Mod+Shift+J { move-window-down; }

    Mod+Ctrl+R { reset-window-height; }
    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }
    Mod+Shift+Minus { set-window-height "-10%"; }
    Mod+Shift+Equal { set-window-height "+10%"; }

    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+0 { focus-workspace 10; }

    Mod+Ctrl+1 { move-window-to-workspace 1; }
    Mod+Ctrl+2 { move-window-to-workspace 2; }
    Mod+Ctrl+3 { move-window-to-workspace 3; }
    Mod+Ctrl+4 { move-window-to-workspace 4; }
    Mod+Ctrl+5 { move-window-to-workspace 5; }
    Mod+Ctrl+6 { move-window-to-workspace 6; }
    Mod+Ctrl+7 { move-window-to-workspace 7; }
    Mod+Ctrl+8 { move-window-to-workspace 8; }
    Mod+Ctrl+9 { move-window-to-workspace 9; }
    Mod+Ctrl+0 { move-window-to-workspace 10; }

    Mod+Shift+1 { move-window-to-workspace 1; }
    Mod+Shift+2 { move-window-to-workspace 2; }
    Mod+Shift+3 { move-window-to-workspace 3; }
    Mod+Shift+4 { move-window-to-workspace 4; }
    Mod+Shift+5 { move-window-to-workspace 5; }
    Mod+Shift+6 { move-window-to-workspace 6; }
    Mod+Shift+7 { move-window-to-workspace 7; }
    Mod+Shift+8 { move-window-to-workspace 8; }
    Mod+Shift+9 { move-window-to-workspace 9; }
    Mod+Shift+0 { move-window-to-workspace 10; }

    Mod+Period { focus-workspace-down; }
    Mod+Comma { focus-workspace-up; }
    Mod+Alt+Down { focus-workspace-down; }
    Mod+Alt+Up { focus-workspace-up; }
    Mod+Ctrl+Down { move-window-to-workspace-down; }
    Mod+Ctrl+Up { move-window-to-workspace-up; }
    Mod+WheelScrollDown cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp cooldown-ms=150 { focus-workspace-up; }

    Print { screenshot; }
    Shift+Print { screenshot-screen; }
    Ctrl+Print { screenshot; }
    Ctrl+Shift+Print { screenshot-screen; }

    Mod+Ctrl+M { quit; }
    Mod+Shift+M { spawn-sh "loginctl terminate-user ''"; }
    Mod+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }
}
