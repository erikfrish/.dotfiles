// -----------------------------------------------------------------------------
// Outputs
// -----------------------------------------------------------------------------
// Niri ignores output blocks whose connector is absent, so it is safe to
// declare all hosts in one shared config.
//
// Verify connector names and exact refresh rates with: niri msg outputs

output "eDP-1" {
    mode "3072x1920@120.000"
    scale 1.75
    // VRR makes i915 disable panel self-refresh (PSR); measured PSR2 only with it off.
}

// Samsung Odyssey G5, matched by make/model/serial: its connector moves
// between DP-3 and DP-4.
output "Samsung Electric Company Odyssey G5 HK2X500523" {
    mode "2560x1440@164.833"
    variable-refresh-rate
}

output "HDMI-A-2" {
    off
}
