// -----------------------------------------------------------------------------
// Outputs
// -----------------------------------------------------------------------------
// Niri ignores output blocks whose connector is absent, so it is safe to
// declare all hosts in one shared config.
//
// Verify connector names and exact refresh rates with: niri msg outputs

output "eDP-1" {
    mode "3072x1920@120.000"
    scale 1.75
    // Disabled while testing niri + NVIDIA frame pacing.
    // variable-refresh-rate
}

output "DP-4" {
    mode "2560x1440@164.833"
    // Disabled while testing niri + NVIDIA frame pacing.
    // variable-refresh-rate
}

output "DP-3" {
    mode "2560x1440@164.833"
}

output "HDMI-A-2" {
    off
}
