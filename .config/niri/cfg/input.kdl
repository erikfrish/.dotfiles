input {
    keyboard {
        xkb {
            // Use a tracked user XKB layout for Russian.
            // The custom variant keeps normal Russian typing, but makes
            // Ctrl/Ctrl+Shift shortcuts resolve as if the physical key was
            // pressed on the US layout. This avoids switching layouts for
            // copy/paste/search/terminal shortcuts.
            layout "us,dotfiles"
            variant ",ru_ctrl_shortcuts"

            // Layout switching is handled by a Niri keybind (Super+Space) instead
            // of XKB grp:win_space_toggle. Niri keybinds properly consume the
            // key event and notify XWayland clients, whereas XKB-only toggles
            // leak the space character into XWayland apps and often fail to sync
            // the active layout to them.
            options ""
        }

        // Always start sessions with NumLock enabled.
        numlock
    }

    touchpad {
        // Physical two-finger click is right click; tap-to-click stays off by
        // omission so accidental touches do not click.
        click-method "clickfinger"
        natural-scroll
    }

    // Mouse hover moves focus, but scrolling over another window should not
    // steal focus from the current one.
    focus-follows-mouse max-scroll-amount="0%"
}
