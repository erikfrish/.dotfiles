// Zen Browser opens at half-screen by default. Force it to fill the column
// like VS Code does, without entering fullscreen mode.
window-rule {
    match app-id=r#"^zen$"#
    default-column-width { proportion 1.0; }
}

window-rule {
    match app-id=r#"^org\.pulseaudio\.pavucontrol$"#
    open-floating true
    default-column-width { fixed 800; }
}

window-rule {
    match app-id=r#"^blueman-manager$"#
    open-floating true
    default-column-width { fixed 800; }
}

window-rule {
    match app-id=r#"^nm-connection-editor$"#
    open-floating true
    default-column-width { fixed 800; }
}

window-rule {
    match app-id=r#"^wofi$"#
    open-floating true
}

window-rule {
    match title=r#"(?i)(^|[^[:alnum:]_])(pip|picture[-[:space:]]*in[-[:space:]]*picture)([^[:alnum:]_]|$)"#
    open-floating true
    default-column-width { fixed 584; }
}
