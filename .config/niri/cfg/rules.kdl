// -----------------------------------------------------------------------------
// Window Rules
// -----------------------------------------------------------------------------

// Zen Browser opens at half-screen by default. Force it to fill the column
// like VS Code does, without entering fullscreen mode.
// Utility dialogs work better as floating windows than as full Niri columns.
window-rule {
    match app-id=r#"^zen$"#
    default-column-width { proportion 1.0; }
}

// Picture-in-picture windows should stay small and floating regardless of app.
window-rule {
    match app-id=r#"^org\.pulseaudio\.pavucontrol$"#
    open-floating true
    default-column-width { fixed 800; }
}

window-rule {
    match app-id=r#"^blueman-manager$"#
    open-floating true
    default-column-width { fixed 800; }
}

window-rule {
    match app-id=r#"^nm-connection-editor$"#
    open-floating true
    default-column-width { fixed 800; }
}

window-rule {
    match app-id=r#"^rofi$"#
    open-floating true
}

window-rule {
    match title=r#"(?i)(^|[^[:alnum:]_])(pip|picture[-[:space:]]*in[-[:space:]]*picture)([^[:alnum:]_]|$)"#
    open-floating true
    default-column-width { fixed 480; }
    default-window-height { fixed 270; }
    // min-width 320
    // min-height 180
}
