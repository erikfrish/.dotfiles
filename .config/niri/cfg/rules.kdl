window-rule {
    match app-id=r#"^org\.pulseaudio\.pavucontrol$"#
    open-floating true
    default-column-width { fixed 800; }
}

window-rule {
    match app-id=r#"^blueman-manager$"#
    open-floating true
    default-column-width { fixed 800; }
}

window-rule {
    match app-id=r#"^nm-connection-editor$"#
    open-floating true
    default-column-width { fixed 800; }
}

window-rule {
    match app-id=r#"^wofi$"#
    open-floating true
}

window-rule {
    match title=r#"^(.*[Pp][Ii][Pp].*|[Pp]icture.?in.?[Pp]icture.*)$"#
    open-floating true
    default-column-width { fixed 584; }
}
