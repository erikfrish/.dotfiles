// -----------------------------------------------------------------------------
// Layout
// -----------------------------------------------------------------------------

layout {
    // Compact gaps keep the scrollable column layout dense without removing the
    // visual separation between windows.
    gaps 8
    center-focused-column "on-overflow"

    // These widths cover the common laptop cases: side-by-side reference, main
    // editor/browser, and single-column focus.
    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
        proportion 1.0
    }

    default-column-width { proportion 0.5; }

    // The focus ring is the main active-window cue because borders are disabled.
    focus-ring {
        width 3
        active-color "#cba6f7"
        inactive-color "#6E6A86"
    }

    border {
        off
    }

    // A subtle shadow gives floating windows and unfocused columns depth without
    // making the theme depend on compositor-specific decorations.
    shadow {
        on
        softness 30
        spread 5
        offset x=0 y=5
        color "#0007"
    }
}

hotkey-overlay {
    skip-at-startup
}

// Ask GTK/Qt apps to avoid client-side decorations when they support it.
prefer-no-csd

screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

animations {
    // Keep Niri defaults for now.
}
