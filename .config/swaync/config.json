{
  "$schema": "/etc/xdg/swaync/configSchema.json",
  "ignore-gtk-theme": true,
  "positionX": "center",
  "positionY": "top",
  "control-center-margin-top": 10,
  "control-center-margin-bottom": 10,
  "control-center-margin-right": 10,
  "notification-body-image-height": 100,
  "notification-body-image-width": 200,
  "timeout": 10,
  "timeout-low": 5,
  "timeout-critical": 0,
  "fit-to-screen": true,
  "control-center-width": 520,
  "control-center-height": 860,
  "notification-window-width": 500,
  "keyboard-shortcuts": true,
  "image-visibility": "when-available",
  "transition-time": 200,
  "hide-on-clear": false,
  "hide-on-action": true,
  "script-fail-notify": true,
  "scripts": {
    "focus-notification-source": {
      "exec": "~/.config/swaync/focus-notification-source",
      "run-on": "action"
    }
  },
  "text-empty": "No Notification",
  "widgets": ["buttons-grid", "mpris", "notifications"],
  "widget-config": {
    "title": {
      "text": "Notification Center",
      "clear-all-button": true,
      "button-text": "󰆴 Clear All"
    },
    "mpris": {
      "blacklist": ["playerctl"],
      "autohide": true,
      "show-album-art": "always",
      "loop-carousel": false
    },
    "volume": {
      "label": "󰕾"
    },
    "backlight": {
      "label": "󰃟"
    },
    "buttons-grid": {
      "actions": [
        {
          "label": "󰐥",
          "command": "systemctl poweroff"
        },
        {
          "label": "󰜉",
          "command": "systemctl reboot"
        },
        {
          "label": "󰌾",
          "command": "pidof hyprlock || hyprlock --grace 10"
        },
        {
          "label": "󰍃",
          "command": "niri msg action quit"
        },
        {
          "label": "󰖁",
          "command": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
          "type": "toggle",
          "update-command": "pactl get-sink-mute @DEFAULT_SINK@ | grep -q yes && echo true || echo false"
        },
        {
          "label": "󰆴",
          "command": "swaync-client -C"
        },
        {
          "label": "󰖩",
          "command": "swaync-client -t -sw && iwgtk"
        },
        {
          "label": "󰂯",
          "command": "swaync-client -t -sw && overskride"
        },
        {
          "label": "",
          "command": "swaync-client -t -sw && kooha"
        },
        {
          "label": "󰖔",
          "label-active": "󰖔",
          "command": "systemctl --user is-active --quiet gammastep.service && systemctl --user stop gammastep.service || systemctl --user start gammastep.service",
          "type": "toggle",
          "update-command": "systemctl --user is-active --quiet gammastep.service && echo true || echo false"
        },
        {
          "label": "",
          "command": "pactl set-source-mute @DEFAULT_SOURCE@ toggle",
          "type": "toggle",
          "update-command": "pactl get-source-mute @DEFAULT_SOURCE@ | grep -q yes && echo true || echo false"
        },
        {
          "label": "󰂛",
          "label-active": "󰂚",
          "command": "swaync-client -d",
          "type": "toggle",
          "update-command": "swaync-client -D",
          "active": false
        }
      ]
    }
  }
}
