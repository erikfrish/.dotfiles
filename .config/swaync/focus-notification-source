#!/usr/bin/env bash

set -u

desktop_entry=${SWAYNC_DESKTOP_ENTRY:-}
app_name=${SWAYNC_APP_NAME:-}

normalize() {
  printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | sed 's/\.desktop$//'
}

desktop_entry=$(normalize "$desktop_entry")
app_name=$(normalize "$app_name")

[ -n "$desktop_entry$app_name" ] || exit 0

if [[ ":${XDG_CURRENT_DESKTOP:-}:" == *:Hyprland:* ]]; then
  windows=$(hyprctl -j clients) || exit 0
else
  windows=$(niri msg -j windows) || exit 0
fi

id=$(
  jq -r \
    --arg desktop "$desktop_entry" \
    --arg app "$app_name" '
      def norm: ascii_downcase | sub("\\.desktop$"; "");
      def hit($s):
        ($s | norm) as $n |
        ($desktop != "" and ($n == $desktop or ($n | contains($desktop)) or ($desktop | contains($n)))) or
        ($app != "" and ($n == $app or ($n | contains($app)) or ($app | contains($n))));
      map(select(hit(.app_id // .class // "") or hit(.title // "")))
      | sort_by(if has("focusHistoryID") then [-.focusHistoryID, 0]
                else [.focus_timestamp.secs // 0, .focus_timestamp.nanos // 0] end)
      | last
      | (.id // .address) // empty
    ' <<<"$windows"
)

[ -n "$id" ] || exit 0
if [[ ":${XDG_CURRENT_DESKTOP:-}:" == *:Hyprland:* ]]; then
  hyprctl dispatch "hl.dsp.focus({ window = [[address:$id]] })" >/dev/null
else
  niri msg action focus-window --id "$id" >/dev/null 2>&1 || true
fi
