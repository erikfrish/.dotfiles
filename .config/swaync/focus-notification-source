#!/usr/bin/env bash

set -u

desktop_entry=${SWAYNC_DESKTOP_ENTRY:-}
app_name=${SWAYNC_APP_NAME:-}

normalize() {
  printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | sed 's/\.desktop$//'
}

desktop_entry=$(normalize "$desktop_entry")
app_name=$(normalize "$app_name")

[ -n "$desktop_entry$app_name" ] || exit 0

hypr_focus() {
  command -v hyprctl >/dev/null 2>&1 || return 1
  [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ] || return 1

  local address
  address=$(
    hyprctl clients -j 2>/dev/null | jq -r \
      --arg desktop "$desktop_entry" \
      --arg app "$app_name" '
        def norm: ascii_downcase | sub("\\.desktop$"; "");
        def hit($s):
          ($s | norm) as $n |
          ($desktop != "" and ($n == $desktop or ($n | contains($desktop)) or ($desktop | contains($n)))) or
          ($app != "" and ($n == $app or ($n | contains($app)) or ($app | contains($n))));
        map(select(hit(.class // "") or hit(.initialClass // "") or hit(.title // "")))
        | sort_by(.focusHistoryID // 999999)
        | .[0].address // empty
      '
  )

  [ -n "$address" ] || return 1
  hyprctl dispatch focuswindow "address:$address" >/dev/null 2>&1
}

niri_focus() {
  command -v niri >/dev/null 2>&1 || return 1

  local id
  id=$(
    niri msg -j windows 2>/dev/null | jq -r \
      --arg desktop "$desktop_entry" \
      --arg app "$app_name" '
        def norm: ascii_downcase | sub("\\.desktop$"; "");
        def hit($s):
          ($s | norm) as $n |
          ($desktop != "" and ($n == $desktop or ($n | contains($desktop)) or ($desktop | contains($n)))) or
          ($app != "" and ($n == $app or ($n | contains($app)) or ($app | contains($n))));
        map(select(hit(.app_id // "") or hit(.title // "")))
        | sort_by(.focus_timestamp.secs // 0, .focus_timestamp.nanos // 0)
        | reverse
        | .[0].id // empty
      '
  )

  [ -n "$id" ] || return 1
  niri msg action focus-window --id "$id" >/dev/null 2>&1
}

hypr_focus || niri_focus || exit 0
