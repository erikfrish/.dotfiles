[exchange]
service_endpoint = "https://mail.example.com/EWS/Exchange.asmx"
owa_url = "https://mail.example.com/owa/"
auth_type = "ntlm"          # or "basic"
timeout_seconds = 20

[nextcloud]
url = "https://cloud.example.com/remote.php/dav"
username = "your-user"
calendar_url = "https://cloud.example.com/remote.php/dav/calendars/your-user/work/"

[sync]
lookback_days = 7
lookahead_days = 60
max_attachment_bytes = 10485760
max_total_attachment_bytes = 20971520
state_file = "~/.local/state/outlook-nextcloud-sync/state.json"