[Unit]
Description=Wayland idle handling
PartOf=dotfiles-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/env bash -lc 'case "${XDG_CURRENT_DESKTOP:-}" in *Hyprland*) off="hyprctl dispatch dpms off"; on="hyprctl dispatch dpms on" ;; *) off="niri msg action power-off-monitors"; on="niri msg action power-on-monitors" ;; esac; exec swayidle -w before-sleep "pidof hyprlock || hyprlock" timeout 660 "$off" resume "$on" timeout 3600 "pidof hyprlock || hyprlock"'
Restart=on-failure
RestartSec=1

[Install]
WantedBy=dotfiles-session.target
