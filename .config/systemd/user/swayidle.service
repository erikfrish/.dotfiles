[Unit]
Description=Niri idle handling
PartOf=dotfiles-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=swayidle -w before-sleep 'pidof hyprlock || hyprlock' timeout 330 'niri msg action power-off-monitors' resume 'niri msg action power-on-monitors' timeout 1800 'pidof hyprlock || hyprlock'
Restart=on-failure
RestartSec=1

[Install]
WantedBy=dotfiles-session.target
