// erikfrish custom settings.json for vscode. Copy to settings.json if desired.
{
  // Main editor settings
  "window.customMenuBarAltFocus": false,
  "git.addAICoAuthor": "off",
  // disables gtk window title bar
  "window.titleBarStyle": "custom",
  "window.customTitleBarVisibility": "auto",
  "window.openFilesInNewWindow": "off",
  "editor.tabSize": 4,
  "editor.lineHeight": 1.2,
  // "editor.wordWrap": "bounded",
  // "editor.wrappingIndent": "same",
  // "editor.wordWrapColumn": 60,
  // "editor.folding": false,
  // "editor.renderWhitespace": "boundary", //отображение пробелов
  "editor.insertSpaces": true, //вставка пробелов
  "editor.smoothScrolling": true, //плавная прокрутка
  "editor.minimap.enabled": false,
  "editor.detectIndentation": true,
  "editor.suggestSelection": "first",
  "editor.bracketPairColorization.enabled": true,
  "editor.linkedEditing": true,
  "editor.codeLens": true,
  
  "remote.SSH.useLocalServer": true,
  "remote.SSH.enableAgentForwarding": true,
  // "ssh."
  "rust-analyzer.highlighting.strings": true,
  "csharp.semanticHighlighting.enabled": true,
  "editor.tokenColorCustomizations": {
    "[Kanagawa]": {
      "comments": {
        "foreground": "#FF9E3B"
      }
    },
    "[Kanagawa Vscode]": {
      "comments": {
        "foreground": "#825629"
      }
    }
  },
  
  // FONTS
  // "editor.fontFamily": "JetBrainsMono Nerd Font Mono, monospace",
  "editor.fontFamily": "JetBrainsMono Nerd Font",
  // "editor.fontFamily": "FiraCode Nerd Font",
  "editor.fontSize": 14,
  // "editor.fontFamily": "FantasqueSansMono Nerd Font Mono", 
  // "terminal.integrated.fontFamily": "FuraMono Nerd Font",  
  // "terminal.integrated.fontFamily": "BigBlue_TerminalPlus Nerd Font", 
  "terminal.integrated.fontFamily": "monospace",  
  // "terminal.integrated.fontSize": "14", 
  // "terminal.integrated.fontFamily": "3270SemiCondensed NFM", 
  // "terminal.integrated.fontFamily" : "GohuFont Nerd Font",
  
  
  // GO
  "go.vetOnSave": "package",
  "go.vetFlags": [],
  "go.lintTool": "golangci-lint",
  "go.lintFlags": [
    "--path-mode=abs",
    "--fast-only"
  ],
  "go.formatTool": "custom",
  "go.alternateTools": {
    "customFormatter": "golangci-lint"
  },
  "go.formatFlags": [
    "fmt",
    "--stdin"
  ],
  "go.lintOnSave": "package",
  // "go.useLanguageServer": true,
  "go.diagnostic.vulncheck": "Imports",
  "go.testTimeout": "5m",
  "go.editorContextMenuCommands": {
    "toggleTestFile": true,
    "addTags": true,
    "removeTags": false,
    "fillStruct": false,
    "testAtCursor": true,
    "testFile": false,
    "testPackage": false,
    "generateTestForFunction": true,
    "generateTestForFile": false,
    "generateTestForPackage": false,
    "addImport": true,
    "testCoverage": true,
    "playground": true,
    "debugTestAtCursor": true,
    "benchmarkAtCursor": false
  },
  "gopls": {
    "ui.semanticTokens": true,
    // "build.buildFlags": [
    //   "-ldflags=-linkmode=internal",
    // ],
  },
  "go.testFlags": [
    // "-ldflags=-linkmode=internal",
    // "-gcflags=all=-N -l"
  ],
  // "go.gopath": "~/go",
  // "go.toolsGopath": "~/go",
  // "go.golangciLintPath": "/home/erikfrish/go/bin/golangci-lint",
  

  // Explorer
  "explorer.confirmDelete": false,
  "explorer.compactFolders": true,
  "explorer.confirmDragAndDrop": false,

  // Spell checker
  "cSpell.enabled": true,
  "cSpell.language": "en, ru",
  "cSpell.ignoreWords": [],
