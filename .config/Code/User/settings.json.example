  "editor.accessibilitySupport": "off",
  "keyboard.dispatch": "keyCode",
  "git.useIntegratedAskPass": false,
  "git.terminalAuthentication": false,

  "git.autofetch": true,
  "go.toolsManagement.autoUpdate": true,
  // "terminal.integrated.enableMultiLinePasteWarning": false,
  
  "terminal.integrated.env.osx": {
    "FIG_NEW_SESSION": "1"
  },

  // "workbench.editorAssociations": {
  //   "*.db": "sqlite-viewer.option"
  // },
  "python.diagnostics.sourceMapsEnabled": true,

  // GITLAB
  "gitlab.showPipelineUpdateNotifications": true,
  "gitlab.customQueries": [

    {
      "name": "Issues assigned to me",
      "type": "issues",
      "scope": "assigned_to_me",
      "state": "opened",
      "noItemText": "There is no issue assigned to you."
    },
    {
      "name": "Issues created by me",
      "type": "issues",
      "scope": "created_by_me",
      "state": "opened",
      "noItemText": "There is no issue created by you."
    },
    {
      "name": "Merge requests assigned to me",
      "type": "merge_requests",
      "scope": "assigned_to_me",
      "state": "opened",
      "noItemText": "There is no MR assigned to you."
    },
    {
      "name": "Merge requests I'm reviewing",
      "type": "merge_requests",
      "reviewer": "<current_user>",
      "state": "opened",
      "noItemText": "There is no MR for you to review."
    },
    {
      "name": "Merge requests created by me",
      "type": "merge_requests",
      "scope": "created_by_me",
      "state": "opened",
      "noItemText": "There is no MR created by you."
    },
    {
      "name": "All project merge requests",
      "type": "merge_requests",
      "scope": "all",
      "state": "opened",
      "noItemText": "The project has no merge requests"
    }
  ],

  // GITHUB COPILOT
  "github.copilot.enable": {
    "*": false,
    "plaintext": false,
    "markdown": false,
    "scminput": false
  },

  // GITBLAME
  "gitblame.inlineMessageEnabled": true,
  "gitblame.inlineMessageFormat": "${author.name}, ${time.ago} • ${commit.summary}",
  "gitblame.delayBlame": 400,
  "gitblame.inlineMessageMargin": 5,
  "gitblame.statusBarMessageClickAction": "Open git show",
  "gitblame.statusBarMessageFormat": "",
  "gitlens.hovers.currentLine.over": "line",

  "git.confirmSync": false,
  "git.enableSmartCommit": true,
  "git.ignoreRebaseWarning": true,
  "inlineSQL.enableDBIntegration": true,
  "[python]": {
    "editor.formatOnType": true
  },
  "terminal.external.osxExec": "iTerm.app",
  "database-client.showUser": true,
  "database-client.showTrigger": true,
  "database-client.saveConnectionExpandedState": true,
  "database-client.showEvent": true,
  "database-client.autoPagingSQL": false,
  "database-client.bindConnectionByActiveMark": false,
  "database-client.executeCursorSQLByShortcut": false,
  "workbench.productIconTheme": "fluent-icons",
  "tabnine.experimentalAutoImports": true,
  "notebook.lineNumbers": "on",


  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[html]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "sonarlint.rules": {
    
    "php:S100": {
      "level": "off"
    }
  },
  "sonarlint.disableTelemetry": true,
  "workbench.editorAssociations": {
    "*.copilotmd": "vscode.markdown.preview.editor",
    "*.docx": "docxreader.docxEditor",
    "*.csv": "default",
    "*.md": "default"
  },
  "aws.telemetry": false,
  "aws.codeWhisperer.shareCodeWhispererContentWithAWS": false,
  "aws.suppressPrompts": {
    "codeWhispererConnectionExpired": true
  },
  "database-client.escapedAllObjectName": true,
  "php.problems.excludeGitIgnore": true,
  "php.highlight-todo.enable": false,
  "leetcode.workspaceFolder": "/Users/mac/.leetcode",
  "leetcode.hint.configWebviewMarkdown": false,
  "leetcode.hint.commentDescription": false,
  "leetcode.defaultLanguage": "golang",
  "leetcode.hint.commandShortcut": false,
  "leetcode.endpoint": "leetcode",
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "vs-kubernetes": {
    "vscode-kubernetes.helm-path-mac": "/Users/mac/.vs-kubernetes/tools/helm/darwin-arm64/helm",
    "vscode-kubernetes.minikube-path-mac": "/Users/mac/.vs-kubernetes/tools/minikube/darwin-arm64/minikube",
    "vs-kubernetes.kubeconfig": {
      "nodeType": "context",
      "nodeCategory": "kubernetes-explorer-node",
      "contextName": "docker-desktop",
      "kubectlContext": {
        "clusterName": "docker-desktop",
        "contextName": "docker-desktop",
        "userName": "docker-desktop",
        "active": true
      }
    }
  },
  "keyrunner-lite-by-liam.folderLocation": "/Users/mac/Library/Application Support/Code/User/globalStorage/keyrunner-lite-by-liam",
  "workbench.colorCustomizations": {
    "editorGhostText.foreground": "#7A8E96",
  //   "[Kanagawa]": {
  //   "activityBar.background": "#1F1F28",
  //   "activityBar.border": "#2A2A37",
  //   "editorGroup.border": "#2A2A37",
  //   "sideBar.background": "#2A2A37",
  //   "sideBar.border": "#2A2A37",
  //   "sideBar.foreground": "#DCD7BA"
  // },
  },
  "workbench.iconTheme": "catppuccin-frappe",
  "scm.experimental.showHistoryGraph": true,
  "vscode-office.editorTheme": "Auto",
  "[yaml]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"

  },
  "cloudcode.duetAI.project": "tough-progress-432508-k7",
  "makefile.configureOnOpen": true,
  "editor.largeFileOptimizations": false,
  "vscode-office.openOutline": true,
  "[markdown]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "database-client.autoSync": true,
  "diffviewer.colorScheme": "dark",
  "diffviewer.renderNothingWhenEmpty": true,

  "files.associations": {
    "*.sql": "sql"
  },
  "idf.hasWalkthroughBeenShown": true,
  "idf.espIdfPath": "/home/erikfrish/esp/esp-idf",
  "idf.toolsPath": "/home/erikfrish/.espressif",
  "idf.gitPath": "git",
  "idf.pythonInstallPath": "/usr/bin/python",
  "docker.extension.enableComposeLanguageServer": false,
  "[dockercompose]": {
    "editor.insertSpaces": true,
    "editor.tabSize": 2,
    "editor.autoIndent": "advanced",
    "editor.quickSuggestions": {
      "other": true,
      "comments": false,
      "strings": true
    },
    "editor.defaultFormatter": "redhat.vscode-yaml"
  },
  "[github-actions-workflow]": {
    "editor.defaultFormatter": "redhat.vscode-yaml"
  },
  "editor.unicodeHighlight.ambiguousCharacters": false,
  "diffEditor.maxComputationTime": 0,
  "diffviewer.outputFormat": "side-by-side",
  "diffEditor.ignoreTrimWhitespace": false,
  "explorer.fileNesting.patterns": {
    "*.ts": "${capture}.js",
    "*.js": "${capture}.js.map, ${capture}.min.js, ${capture}.d.ts",
    "*.jsx": "${capture}.js",
    "*.tsx": "${capture}.ts",
    "tsconfig.json": "tsconfig.*.json",
    "package.json": "package-lock.json, yarn.lock, pnpm-lock.yaml, bun.lockb, bun.lock",
    "*.sqlite": "${capture}.${extname}-*",
    "*.db": "${capture}.${extname}-*",
    "*.sqlite3": "${capture}.${extname}-*",
    "*.db3": "${capture}.${extname}-*",
    "*.sdb": "${capture}.${extname}-*",
    "*.s3db": "${capture}.${extname}-*"
  },
  "[css]": {
    "editor.defaultFormatter": "vscode.css-language-features"
  },
  "chat.viewSessions.orientation": "stacked",
  "gitlens.ai.model": "vscode",
  "gitlens.ai.vscode.model": "copilot:gpt-4.1",
  "workbench.colorTheme": "Kanagawa",
  "workbench.editor.enablePreview": false

  // "editor.inlayHints.enabled": "off",
