#!/bin/bash

DIR="$HOME/Pictures/Wallpapers"
ENV_VAR="HYPR_WALLPAPER_INDEX"

# Корректно собираем файлы в массив (даже если в именах пробелы)
# Сортируем, чтобы порядок был предсказуемым
mapfile -t PICS < <(find "$DIR" -maxdepth 1 -type f \( -name "*.jpg" -o -name "*.jpeg" -o -name "*.png" -o -name "*.gif" -o -name "*.webp" \) | sort)

# Если нет файлов - выходим
if [ ${#PICS[@]} -eq 0 ]; then
  echo "No wallpapers found in $DIR" >&2
  exit 1
fi

# Файл для хранения индекса последнего использованного обоя
STATE_FILE="$HOME/.config/hypr/last_wallpaper_index"
mkdir -p "$(dirname "$STATE_FILE")"

# Читаем предыдущий индекс (если есть)
prev_index=$(systemctl --user show-environment \
  | sed -n "s/^$ENV_VAR=//p")

case "$prev_index" in
  ''|*[!0-9]*) prev_index=-1;;
esac


count=${#PICS[@]}

if [ "$count" -le 1 ]; then
  NEXT_INDEX=0
else
  if ! printf '%s' "$prev_index" | grep -Eq '^[0-9]+$' || [ "$prev_index" -ge "$count" ]; then
    prev_index=-1
  fi
  NEXT_INDEX=$(( (prev_index + 1) % count ))
  # На всякий случай, если получилось тот же самый (маловероятно), сдвигаем ещё на один
  if [ "$NEXT_INDEX" -eq "$prev_index" ] && [ "$count" -gt 1 ]; then
    NEXT_INDEX=$(( (NEXT_INDEX + 1) % count ))
  fi
fi

systemctl --user set-environment "$ENV_VAR=$NEXT_INDEX"

SELECTED_PIC=$(realpath "${PICS[$NEXT_INDEX]}")

# Функция специально для hyprpaper
change_hyprpaper(){
  pkill awww-daemon
  pkill swaybg
  
  # Запускаем, если не запущен
  if ! pgrep -x "hyprpaper" > /dev/null; then
    hyprpaper &
    sleep 0.5
  fi

  # 1. Сначала preload (обязательно полный путь)
  hyprctl hyprpaper preload "$SELECTED_PIC"
  
  # 2. Получаем список мониторов
  MONITORS=$(hyprctl monitors | grep "Monitor" | awk '{print $2}')
  
  # 3. Применяем на все мониторы
  for MONITOR in $MONITORS; do
    # Синтаксис: монитор,путь (БЕЗ пробела после запятой)
    hyprctl hyprpaper wallpaper "$MONITOR,$SELECTED_PIC"
  done
  
  # 4. Чистим память (выгружаем всё, что не используется прямо сейчас)
  hyprctl hyprpaper unload unused
}

change_swaybg(){
  pkill awww-daemon
  pkill hyprpaper
  swaybg -m fill -i "$SELECTED_PIC"
}

change_awww(){
  pkill swaybg
  pkill hyprpaper
  awww query || { awww-daemon & sleep 0.5; }
  awww img "$SELECTED_PIC" --transition-fps 30 --transition-type any --transition-duration 3
}

# Если ничего не указано, проверяем что сейчас запущено
change_current(){
  if pidof hyprpaper >/dev/null; then
    change_hyprpaper
  elif pidof swaybg >/dev/null; then
    change_swaybg
  else
    change_awww
  fi
}

case "$1" in
  "hypr")
    change_hyprpaper
    ;;
  "swaybg")
    change_swaybg
    ;;
  "awww"|"swww")
    change_awww
    ;;
  *)
    change_current
    ;;
esac
