#!/bin/bash

# 1. Поиск пути к AppImage
APP_PATH=( $HOME/Applications/band-desktop-*.AppImage )
# Проверяем, существует ли файл
if [ ! -f "${APP_PATH[0]}" ]; then
    echo "Ошибка: AppImage не найден в $HOME/Applications/"
    exit 1
fi

# 2. Запуск приложения (если еще не запущено)
if ! pgrep -f "band-desktop" > /dev/null; then
    "${APP_PATH[0]}" --silent & 
    APP_PID=$!
else
    echo "Band уже запущен"
fi

# 3. Ожидание появления окна
WINDOW_ADDR=""
for i in {1..40}; do
    # Ищем по классу (обычно "band-desktop" или "Band")
    # Также проверяем initialClass, если обычный class еще пустой
    CLIENTS_JSON=$(hyprctl clients -j)
    WINDOW_ADDR=$(echo "$CLIENTS_JSON" | jq -r '.[] | select(.class == "Band" or .initialClass == "Band") | .address' | head -1)

    if [ -n "$WINDOW_ADDR" ] && [ "$WINDOW_ADDR" != "null" ]; then
        break
    fi
    sleep 0.5
done

# 4. Манипуляции с окном
if [ -n "$WINDOW_ADDR" ] && [ "$WINDOW_ADDR" != "null" ]; then
    # Перемещаем на воркспейс 6 тихо
    hyprctl dispatch movetoworkspacesilent 6,address:$WINDOW_ADDR
    
    # Даем Hyprland время "проглотить" изменения
    sleep 0.3
    
    # Фокусируем и выравниваем
    hyprctl dispatch focuswindow address:$WINDOW_ADDR
    hyprctl dispatch movewindow l
    
    # Возвращаемся на 1 воркспейс, если нужно
    sleep 0.2
    hyprctl dispatch workspace 1
else
    echo "Ошибка: окно Band не появилось вовремя"
fi