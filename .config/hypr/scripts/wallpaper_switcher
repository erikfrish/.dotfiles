#!/bin/bash

CONF="$HOME/.config/hypr/hyprpaper.conf"
DIR="$HOME/Pictures/Wallpapers"

# 1. Форсируем IPC в конфиге и запускаем hyprpaper
if [ -f "$CONF" ]; then
    sed -i 's/ipc = off/ipc = on/g' "$CONF"
fi

if ! pgrep -x "hyprpaper" > /dev/null; then
    hyprpaper &
    sleep 0.5
fi

# 2. Собираем файлы
mapfile -t PICS < <(find "$DIR" -maxdepth 1 -type f \( -name "*.jpg" -o -name "*.jpeg" -o -name "*.png" -o -name "*.webp" \))

# 3. Функция генерации меню с фиксом амперсанда
menu(){
    for i in "${!PICS[@]}"; do
        # Заменяем & на &amp; чтобы wofi не давился
        filename=$(basename "${PICS[$i]}" | sed 's/&/\&amp;/g')
        echo "$i. $filename"
    done
    echo "RANDOM"
}

# 4. Команда wofi (убрал --no-markup и временно --color, если он бьет ошибки)
wofi_command="wofi --show dmenu --prompt 'Wallpaper' --width=25% --height=35% --cache-file=/dev/null"

apply() {
    local file=$(realpath "$1")
    
    # Preload и Wallpaper
    hyprctl hyprpaper preload "$file"
    
    # Получаем мониторы
    MONITORS=$(hyprctl monitors | grep "Monitor" | awk '{print $2}')
    for mon in $MONITORS; do
        hyprctl hyprpaper wallpaper "$mon,$file"
    done
    
    hyprctl hyprpaper unload unused
}

# 5. Запуск
choice=$(menu | $wofi_command)

if [[ -z $choice ]]; then exit 0; fi

if [[ "$choice" == "RANDOM" ]]; then
    target="${PICS[$RANDOM % ${#PICS[@]}]}"
    apply "$target"
else
    # Извлекаем индекс (цифры в начале)
    idx=$(echo "$choice" | grep -o '^[0-9]\+')
    target="${PICS[$idx]}"
    apply "$target"
fi