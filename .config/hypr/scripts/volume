#!/usr/bin/env bash

iDIR="$HOME/.config/hypr/mako/icons"
sink='@DEFAULT_AUDIO_SINK@'
source='@DEFAULT_AUDIO_SOURCE@'
speaker_sink='alsa_output.pci-0000_00_1f.3-platform-skl_hda_dsp_generic.HiFi__Speaker__sink'
max_volume=150

target_sink() {
	if [[ "$(pactl get-default-sink 2>/dev/null)" == "easyeffects_sink" ]]; then
		echo "$speaker_sink"
	else
		pactl get-default-sink
	fi
}

target_source() {
	pactl get-default-source
}

refresh_waybar() {
	pkill -RTMIN+8 waybar 2>/dev/null || true
}

volume_percent() {
	pactl get-sink-volume "$1" | awk -F/ 'NR == 1 { gsub(/ /, "", $2); gsub(/%/, "", $2); print $2 }'
}

is_muted() {
	pactl get-sink-mute "$1" | grep -q yes
}

get_volume() {
	local active_sink
	active_sink=$(target_sink)
	if is_muted "$active_sink"; then
		echo 0
	else
		volume_percent "$active_sink"
	fi
}

get_icon() {
	current=$(get_volume)
	if [[ "$current" -eq 0 ]]; then
		echo "$iDIR/volume-mute.png"
	elif [[ "$current" -le 30 ]]; then
		echo "$iDIR/volume-low.png"
	elif [[ "$current" -le 60 ]]; then
		echo "$iDIR/volume-mid.png"
	else
		echo "$iDIR/volume-high.png"
	fi
}

notify_user() {
	notify-send -h string:x-canonical-private-synchronous:sys-notify -u low -i "$(get_icon)" "Volume : $(get_volume) %"
}

inc_volume() {
	local active_sink
	local current
	local next
	active_sink=$(target_sink)
	current=$(volume_percent "$active_sink")
	next=$((current + 5))
	if ((next > max_volume)); then
		next=$max_volume
	fi
	pactl set-sink-volume "$active_sink" "${next}%" && notify_user && refresh_waybar
}

dec_volume() {
	local active_sink
	active_sink=$(target_sink)
	pactl set-sink-volume "$active_sink" -5% && notify_user && refresh_waybar
}

toggle_mute() {
	local active_sink
	active_sink=$(target_sink)
	pactl set-sink-mute "$active_sink" toggle
	if is_muted "$active_sink"; then
		notify-send -h string:x-canonical-private-synchronous:sys-notify -u low -i "$iDIR/volume-mute.png" "Volume Switched OFF"
	else
		notify-send -h string:x-canonical-private-synchronous:sys-notify -u low -i "$(get_icon)" "Volume Switched ON"
	fi
	refresh_waybar
}

toggle_mic() {
	local active_source
	active_source=$(target_source)
	pactl set-source-mute "$active_source" toggle
	if pactl get-source-mute "$active_source" | grep -q yes; then
		notify-send -h string:x-canonical-private-synchronous:sys-notify -u low -i "$iDIR/microphone-mute.png" "Microphone Switched OFF"
	else
		notify-send -h string:x-canonical-private-synchronous:sys-notify -u low -i "$iDIR/microphone.png" "Microphone Switched ON"
	fi
}

get_mic_icon() {
	echo "$iDIR/microphone.png"
}

notify_mic_user() {
	notify-send -h string:x-canonical-private-synchronous:sys-notify -u low -i "$(get_mic_icon)" "Mic-Level : $(pactl get-source-volume "$(target_source)" | awk -F/ 'NR == 1 { gsub(/ /, "", $2); gsub(/%/, "", $2); print $2 }') %"
}

inc_mic_volume() {
	local active_source
	local current
	local next
	active_source=$(target_source)
	current=$(pactl get-source-volume "$active_source" | awk -F/ 'NR == 1 { gsub(/ /, "", $2); gsub(/%/, "", $2); print $2 }')
	next=$((current + 5))
	if ((next > 100)); then
		next=100
	fi
	pactl set-source-volume "$active_source" "${next}%" && notify_mic_user
}

dec_mic_volume() {
	local active_source
	active_source=$(target_source)
	pactl set-source-volume "$active_source" -5% && notify_mic_user
}

case "${1:-}" in
	--get) get_volume ;;
	--inc) inc_volume ;;
	--dec) dec_volume ;;
	--toggle) toggle_mute ;;
	--toggle-mic) toggle_mic ;;
	--get-icon) get_icon ;;
	--get-mic-icon) get_mic_icon ;;
	--mic-inc) inc_mic_volume ;;
	--mic-dec) dec_mic_volume ;;
	*) get_volume ;;
esac
