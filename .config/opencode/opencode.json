{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["opencode-antigravity-auth@latest"],
  "provider": {
    "google": {
      "models": {
        "antigravity-gemini-3-pro": {
          "name": "Gemini 3 Pro (Antigravity)",
          "limit": { "context": 1048576, "output": 65535 },
          "modalities": { "input": ["text", "image", "pdf"], "output": ["text"] },
          "variants": {
            "low": { "thinkingLevel": "low" },
            "high": { "thinkingLevel": "high" }
          }
        },
        "antigravity-gemini-3.1-pro": {
          "name": "Gemini 3.1 Pro (Antigravity)",
          "limit": { "context": 1048576, "output": 65535 },
          "modalities": { "input": ["text", "image", "pdf"], "output": ["text"] },
          "variants": {
            "low": { "thinkingLevel": "low" },
            "high": { "thinkingLevel": "high" }
          }
        },
        "antigravity-gemini-3-flash": {
          "name": "Gemini 3 Flash (Antigravity)",
          "limit": { "context": 1048576, "output": 65536 },
          "modalities": { "input": ["text", "image", "pdf"], "output": ["text"] },
          "variants": {
            "minimal": { "thinkingLevel": "minimal" },
            "low": { "thinkingLevel": "low" },
            "medium": { "thinkingLevel": "medium" },
            "high": { "thinkingLevel": "high" }
          }
        },
        "antigravity-claude-sonnet-4-6": {
          "name": "Claude Sonnet 4.6 (Antigravity)",
          "limit": { "context": 200000, "output": 64000 },
          "modalities": { "input": ["text", "image", "pdf"], "output": ["text"] }
        },
        "antigravity-claude-opus-4-6-thinking": {
          "name": "Claude Opus 4.6 Thinking (Antigravity)",
          "limit": { "context": 200000, "output": 64000 },
          "modalities": { "input": ["text", "image", "pdf"], "output": ["text"] },
          "variants": {
            "low": { "thinkingConfig": { "thinkingBudget": 8192 } },
            "max": { "thinkingConfig": { "thinkingBudget": 32768 } }
          }
        },
        "gemini-2.5-flash": {
          "name": "Gemini 2.5 Flash (Gemini CLI)",
          "limit": { "context": 1048576, "output": 65536 },
          "modalities": { "input": ["text", "image", "pdf"], "output": ["text"] }
        },
        "gemini-2.5-pro": {
          "name": "Gemini 2.5 Pro (Gemini CLI)",
          "limit": { "context": 1048576, "output": 65536 },
          "modalities": { "input": ["text", "image", "pdf"], "output": ["text"] }
        },
        "gemini-3-flash-preview": {
          "name": "Gemini 3 Flash Preview (Gemini CLI)",
          "limit": { "context": 1048576, "output": 65536 },
          "modalities": { "input": ["text", "image", "pdf"], "output": ["text"] }
        },
        "gemini-3-pro-preview": {
          "name": "Gemini 3 Pro Preview (Gemini CLI)",
          "limit": { "context": 1048576, "output": 65535 },
          "modalities": { "input": ["text", "image", "pdf"], "output": ["text"] }
        },
        "gemini-3.1-pro-preview": {
          "name": "Gemini 3.1 Pro Preview (Gemini CLI)",
          "limit": { "context": 1048576, "output": 65535 },
          "modalities": { "input": ["text", "image", "pdf"], "output": ["text"] }
        },
        "gemini-3.1-pro-preview-customtools": {
          "name": "Gemini 3.1 Pro Preview Custom Tools (Gemini CLI)",
          "limit": { "context": 1048576, "output": 65535 },
          "modalities": { "input": ["text", "image", "pdf"], "output": ["text"] }
        }
      }
    },
    "kilo-openrouter": {
      "models": {
        "z-ai/glm-5:free": {
          "name": "GLM-5 (free via Kilo)"
        }
      },
      "name": "Kilo OpenRouter (public)",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://api.kilo.ai/api/openrouter",
        "headers": {
          "HTTP-Referer": "https://kilocode.ai",
          "X-Title": "Kilo Code"
        }
      }
    },
    "corellm": {
      "name": "wb-core-tools",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "apiKey": "{env:CORELLM_API_KEY}"
      },
      "models": {
        "wb-coder": {
          "name": "wb-coder (GLM-5.1 alias)",
          "reasoning": true,
          "interleaved": { "field": "reasoning_content" },
          "limit": { "context": 202752, "output": 16384 },
          "modalities": { "input": ["text"], "output": ["text"] },
          "provider": {
            "api": "https://corellm.wb.ru/coder/v1"
          },
          "options": {
            "reasoning_effort": "low"
          },
          "variants": {
            "low": { "reasoning_effort": "low" },
            "medium": { "reasoning_effort": "medium" },
            "high": { "reasoning_effort": "high" }
          }
        },
        "glm-51": {
          "name": "GLM-5.1 (coder)",
          "reasoning": true,
          "interleaved": { "field": "reasoning_content" },
          "limit": { "context": 202752, "output": 16384 },
          "modalities": { "input": ["text"], "output": ["text"] },
          "provider": {
            "api": "https://corellm.wb.ru/coder/v1"
          },
          "variants": {
            "low": { "reasoning_effort": "low" },
            "medium": { "reasoning_effort": "medium" },
            "high": { "reasoning_effort": "high" }
          }
        },
        "berrylm-l": {
          "name": "BerryLM-L (reviewer-a)",
          "reasoning": true,
          "interleaved": { "field": "reasoning" },
          "limit": { "context": 262144, "output": 16384 },
          "modalities": { "input": ["text"], "output": ["text"] },
          "provider": {
            "api": "https://aimodels.wb.ru/reviewer-a/v1"
          }
        },
        "berrylm-l-v2": {
          "name": "BerryLM-L v2 (autocomplete)",
          "reasoning": true,
          "interleaved": { "field": "reasoning" },
          "limit": { "context": 262144, "output": 16384 },
          "modalities": { "input": ["text"], "output": ["text"] },
          "provider": {
            "api": "https://aimodels.wb.ru/reviewer-b/v1"
          }
        }
      }
    },
    "llama.cpp": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama-server CUDA local",
      "options": {
        "baseURL": "http://compik.home:7070/v1"
      },
      "models": {
        "qwen3.6-35b-a3b": {
          "name": "Qwen3.6 35B A3B UD-IQ2_M local",
          "limit": {
            "context": 80072,
            "output": 4096
          }
        },
        "Qwen3-Coder-Next-UD-Q4_K_M-80072": {
          "name": "Qwen3-Coder-Next-UD-Q4_K_M-80072",
          "limit": {
            "context": 80072,
            "output": 4096
          }
        },
        "Qwen3-Coder-Next-UD-Q4_K_M-262144": {
          "name": "Qwen3-Coder-Next-UD-Q4_K_M-262144",
          "limit": {
            "context": 162144,
            "output": 8192
          }
        },
        "Qwen3-Coder-Next-UD-Q4_K_M-162144": {
          "name": "Qwen3-Coder-Next-UD-Q4_K_M-162144",
          "limit": {
            "context": 162144,
            "output": 8192
          }
        }
      }
    }
  },
  "model": "openai/gpt-5",
  "small_model": "openai/gpt-5-mini"
}
