#!/usr/bin/env bash
set -euo pipefail

# Resolve the hwmon device registered by the nct6687 module and regenerate
# /etc/fancontrol pointing at it. Runs as ExecStartPre of fancontrol.service,
# so the config always matches the current hwmon numbering after boot.

hwdev=""
for d in /sys/class/hwmon/hwmon*; do
  if [ "$(cat "$d/name" 2>/dev/null)" = "nct6687" ]; then
    hwdev=$(basename "$d")
    break
  fi
done

if [ -z "$hwdev" ]; then
  echo "dotfiles-fancontrol: nct6687 hwmon device not found" >&2
  exit 1
fi

hwp=$(readlink -f "/sys/class/hwmon/$hwdev/device" | sed 's#^/sys/##')

cat > /etc/fancontrol <<EOF
# Generated by dotfiles-fancontrol. Do not edit.
INTERVAL=10
DEVPATH=$hwdev=$hwp
DEVNAME=$hwdev=nct6687

FCTEMPS=$hwdev/pwm3=$hwdev/temp1_input
FCFANS=$hwdev/pwm3=$hwdev/fan3_input
MINTEMP=$hwdev/pwm3=55
MAXTEMP=$hwdev/pwm3=72
MINSTART=$hwdev/pwm3=45
MINSTOP=$hwdev/pwm3=35
MINPWM=$hwdev/pwm3=40
MAXPWM=$hwdev/pwm3=150

FCTEMPS=$hwdev/pwm5=$hwdev/temp1_input
FCFANS=$hwdev/pwm5=$hwdev/fan5_input
MINTEMP=$hwdev/pwm5=55
MAXTEMP=$hwdev/pwm5=72
MINSTART=$hwdev/pwm5=45
MINSTOP=$hwdev/pwm5=35
MINPWM=$hwdev/pwm5=40
MAXPWM=$hwdev/pwm5=150
EOF

echo "dotfiles-fancontrol: regenerated /etc/fancontrol ($hwdev -> $hwp)"
