#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
repo_dir="$(cd -- "$script_dir/.." && pwd)"

read_package_list() {
  local file="$1"
  grep -Ev '^[[:space:]]*(#|$)' "$file"
}

seed_example_files() {
  local source relative target created=0 skipped=0

  echo "==> Creating repo-local files from *.example templates..."
  while IFS= read -r -d '' source; do
    relative="${source#"$repo_dir/"}"
    target="$repo_dir/${relative%.example}"

    if [ -e "$target" ] || [ -L "$target" ]; then
      skipped=$((skipped + 1))
      continue
    fi

    mkdir -p -- "$(dirname -- "$target")"
    cp -p -- "$source" "$target"
    printf '  created %s\n' "${target#"$repo_dir/"}"
    created=$((created + 1))
  done < <(find "$repo_dir" -path "$repo_dir/.git" -prune -o -type f -name '*.example' -print0)

  printf '  created: %s, already existed: %s\n' "$created" "$skipped"
}

seed_example_files

echo ""
echo "==> Installing packages..."
mapfile -t pacman_packages < <(read_package_list "$script_dir/packages.pacman")
sudo pacman -S --needed "${pacman_packages[@]}"

if command -v paru >/dev/null 2>&1; then
  mapfile -t aur_packages < <(read_package_list "$script_dir/packages.aur")
  paru -S --needed "${aur_packages[@]}"
else
  echo "WARNING: paru is not available; skipped AUR packages."
  echo "Run again after installing paru or install packages from scripts/packages.aur manually."
fi

echo ""
echo "==> Stowing dotfiles..."
cd "$repo_dir"
stow --restow --target="$HOME" .

echo ""
echo "==> Running post-install setups..."
echo ""
echo "[1/6] SSH agent service"
"$script_dir/setup-ssh-agent" || true
echo ""
echo "[2/6] YubiKey pool"
"$repo_dir/.local/bin/yubikey-pool-setup" || true
echo ""
echo "[3/6] System config files (PAM)"
echo "  Run: sudo ~/.dotfiles/scripts/setup-pam"
echo ""
echo "[4/6] Power profile automation"
echo "  Run: sudo ~/.dotfiles/scripts/setup-power"
echo ""
echo "[5/6] DDC/CI backlight driver (external monitors)"
echo "  Run: sudo ~/.dotfiles/scripts/setup-ddcci"
echo ""
echo "[6/6] Home split DNS"
echo "  Run: ~/.dotfiles/scripts/setup-home-dns <networkmanager-connection>"
echo ""
echo "Validation: ~/.dotfiles/scripts/doctor"
