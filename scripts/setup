#!/bin/bash
set -euo pipefail

echo "==> Installing packages..."
sudo pacman -S --needed \
  hyprland niri xwayland-satellite waybar polkit-kde-agent \
  xdg-desktop-portal-hyprland xdg-desktop-portal-gtk \
  ly hyprlock hypridle \
  rofi rofi-emoji rofi-calc wlogout \
  pipewire wireplumber pipewire-pulse pavucontrol \
  brightnessctl ddcutil wob swayosd \
  swaync libnotify \
  wl-clipboard cliphist wl-clip-persist imagemagick \
  grim slurp hyprland-contrib \
  awww \
  networkmanager nm-connection-editor network-manager-applet bluez blueman \
  fprintd libfprint fcitx5 \
  gammastep hyprpicker playerctl \
  zsh alacritty \
  jq socat gsimplecal btop paru curl \
  ttf-jetbrains-mono-nerd \
  xkeyboard-config xkbcli

paru -S --needed arch-update-tray sshpass ddcci-driver-linux-dkms-git

echo ""
echo "==> Stowing dotfiles..."
cd ~/.dotfiles
stow --restow --target="$HOME" .

echo ""
echo "==> Running post-install setups..."
echo ""
echo "[1/3] DDC/CI backlight driver (external monitors)"
echo "  Run: sudo ~/.dotfiles/scripts/setup-ddcci"
echo ""
echo "[2/3] SSH agent service"
echo "  Run: ~/.dotfiles/scripts/setup-ssh-agent"
echo ""
echo "[3/3] YubiKey pool"
echo "  Run: ~/.dotfiles/.local/bin/yubikey-pool-setup"
