#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
repo_dir="$(cd -- "$script_dir/.." && pwd)"

deploy() {
  local src="$1" dest="$2" mode="$3"
  if [[ ! -f "$src" ]]; then
    printf 'Missing source: %s\n' "$src" >&2
    exit 1
  fi
  if [[ -f "$dest" ]]; then
    local backup="${dest}.bak.$(date +%Y%m%d-%H%M%S)"
    sudo cp -a "$dest" "$backup"
    printf 'Backed up %s to %s\n' "$dest" "$backup"
  fi
  sudo install -Dm"$mode" "$src" "$dest"
  printf 'Installed %s\n' "$dest"
}

deploy "$repo_dir/scripts/root/dotfiles-fancontrol" "/usr/local/libexec/dotfiles-fancontrol" 755
deploy "$repo_dir/etc/systemd/system/fancontrol.service.d/override.conf" "/etc/systemd/system/fancontrol.service.d/override.conf" 644
deploy "$repo_dir/etc/modprobe.d/nct6683_blacklist.conf" "/etc/modprobe.d/nct6683_blacklist.conf" 644
deploy "$repo_dir/etc/modules-load.d/nct6687.conf" "/etc/modules-load.d/nct6687.conf" 644
deploy "$repo_dir/etc/systemd/system/dotfiles-wol.service" "/etc/systemd/system/dotfiles-wol.service" 644

printf '\n==> Regenerating /etc/fancontrol...\n'
/usr/local/libexec/dotfiles-fancontrol

printf '\n==> Enabling services...\n'
sudo systemctl daemon-reload
sudo systemctl enable --now dotfiles-wol.service
sudo systemctl enable fancontrol.service
sudo systemctl restart fancontrol.service

printf '\nDone. Status:\n'
systemctl is-active dotfiles-wol.service fancontrol.service || true
systemctl is-enabled dotfiles-wol.service fancontrol.service || true
