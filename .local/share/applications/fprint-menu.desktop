[Desktop Entry]
Type=Application
Name=Fingerprint Menu
Comment=Manage enrolled fingerprints
Exec=sh -lc 'exec alacritty --title "Fingerprint Menu" -e sudo --preserve-env=DISPLAY,WAYLAND_DISPLAY,XDG_RUNTIME_DIR,DBUS_SESSION_BUS_ADDRESS,SWAYSOCK env HOME="$HOME" USER="$USER" "$HOME/.config/desktop/scripts/fprint_menu"'
Icon=preferences-desktop-user-password
Terminal=false
Categories=Settings;System;Security;
Keywords=fingerprint;fprint;fprintd;auth;security;finger;
StartupNotify=false
