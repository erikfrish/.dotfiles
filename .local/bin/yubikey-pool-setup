#!/usr/bin/env bash
set -euo pipefail

DOTFILES_DIR="${DOTFILES_DIR:-$HOME/.dotfiles}"
POOL_FILE="$HOME/.ssh/yubikeys.tsv"
SOURCE_POOL_FILE="$DOTFILES_DIR/.ssh/yubikeys.tsv"
CURRENT_KEY_SCRIPT="$HOME/.ssh/scripts/current_yubikey"
START_AGENT_SCRIPT="$HOME/.ssh/scripts/start_ssh_agent"
SSH_CONFIG="$HOME/.ssh/config"
SSH_INCLUDE_DIR="$HOME/.ssh/config.d"
SSH_INCLUDE_FILE="$SSH_INCLUDE_DIR/yubikey-pool.conf"
SSH_INCLUDE_LINE='Include ~/.ssh/config.d/yubikey-pool.conf'
NO_SYSTEMD=0

usage() {
  cat <<'EOF'
Usage: yubikey-pool-setup [--no-systemd]

Installs the YubiKey pool wiring for git SSH signing, SSH identities, and env.
EOF
}

die() {
  printf 'yubikey-pool-setup: %s\n' "$*" >&2
  exit 1
}

need_cmd() {
  command -v "$1" >/dev/null 2>&1 || die "required command is missing: $1"
}

expand_path() {
  case "$1" in
    '~') printf '%s\n' "$HOME" ;;
    '~/'*) printf '%s/%s\n' "$HOME" "${1#\~/}" ;;
    *) printf '%s\n' "$1" ;;
  esac
}

link_if_safe() {
  local source="$1"
  local target="$2"

  [ -e "$source" ] || die "source file is missing: $source"
  if [ -L "$target" ] && [ "$(readlink "$target")" = "$source" ]; then
    return 0
  fi
  if [ -e "$target" ] || [ -L "$target" ]; then
    printf 'Keeping existing file: %s\n' "$target" >&2
    return 0
  fi
  ln -s "$source" "$target"
}

ensure_pool_file() {
  if [ -e "$POOL_FILE" ] || [ -L "$POOL_FILE" ]; then
    return 0
  fi

  if [ -e "$SOURCE_POOL_FILE" ]; then
    link_if_safe "$SOURCE_POOL_FILE" "$POOL_FILE"
    return 0
  fi

  printf '# serial\tname\tidentity_file\tpublic_key_file\n' > "$POOL_FILE"
  chmod 600 "$POOL_FILE"
}

ensure_line() {
  local file="$1"
  local line="$2"

  mkdir -p "$(dirname "$file")"
  touch "$file"
  grep -Fxq "$line" "$file" 2>/dev/null && return 0
  printf '%s\n' "$line" >> "$file"
}

prepend_line() {
  local file="$1"
  local line="$2"
  local tmp

  mkdir -p "$(dirname "$file")"
  touch "$file"
  grep -Fxq "$line" "$file" 2>/dev/null && return 0
  tmp="$(mktemp)"
  {
    printf '%s\n' "$line"
    cat "$file"
  } > "$tmp"
  mv "$tmp" "$file"
}

write_ssh_include() {
  local tmp serial name identity_file public_key_file rest

  [ -r "$POOL_FILE" ] || die "pool file is missing: $POOL_FILE"
  mkdir -p "$SSH_INCLUDE_DIR"
  tmp="$(mktemp)"
  {
    printf '# Generated by yubikey-pool-setup from ~/.ssh/yubikeys.tsv\n'
    printf 'Host *\n'
    printf '  AddKeysToAgent yes\n'
    while IFS=$'\t' read -r serial name identity_file public_key_file rest; do
      [ -n "${serial:-}" ] || continue
      case "$serial" in \#*) continue ;; esac
      printf '  IdentityFile %s\n' "$identity_file"
    done < "$POOL_FILE"
  } > "$tmp"
  mv "$tmp" "$SSH_INCLUDE_FILE"
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --no-systemd) NO_SYSTEMD=1 ;;
    -h|--help) usage; exit 0 ;;
    *) usage >&2; exit 2 ;;
  esac
  shift
done

need_cmd git
need_cmd grep
need_cmd ssh-add
need_cmd ykman

mkdir -p "$HOME/.ssh/scripts" "$HOME/.ssh/controlmasters" "$SSH_INCLUDE_DIR" "$HOME/.config/environment.d" "$HOME/.config/systemd/user"
chmod 700 "$HOME/.ssh"
chmod 700 "$HOME/.ssh/controlmasters"

ensure_pool_file
link_if_safe "$DOTFILES_DIR/.ssh/scripts/current_yubikey" "$CURRENT_KEY_SCRIPT"
link_if_safe "$DOTFILES_DIR/.ssh/scripts/start_ssh_agent" "$START_AGENT_SCRIPT"
chmod +x "$DOTFILES_DIR/.ssh/scripts/current_yubikey" "$DOTFILES_DIR/.ssh/scripts/start_ssh_agent"

write_ssh_include
prepend_line "$SSH_CONFIG" "$SSH_INCLUDE_LINE"

git config --global commit.gpgsign true
git config --global gpg.format ssh
git config --global gpg.ssh.sshProgram ssh
git config --global gpg.ssh.defaultKeyCommand "$CURRENT_KEY_SCRIPT"
git config --global core.sshCommand 'env -u GIT_ASKPASS -u SSH_AUTH_SOCK SSH_ASKPASS=/bin/true SSH_ASKPASS_REQUIRE=never ssh -o StrictHostKeyChecking=yes -o UpdateHostKeys=no -o ControlMaster=auto -o ControlPath=~/.ssh/ssh-conn-%C -o ControlPersist=4h'

ensure_line "$HOME/.config/environment.d/profile.conf" 'SSH_AUTH_SOCK=$XDG_RUNTIME_DIR/ssh-agent.socket'
ensure_line "$HOME/.zprofile" 'export SSH_AUTH_SOCK="$XDG_RUNTIME_DIR/ssh-agent.socket"'

if [ -e "$DOTFILES_DIR/.config/systemd/user/ssh-agent.service" ]; then
  link_if_safe "$DOTFILES_DIR/.config/systemd/user/ssh-agent.service" "$HOME/.config/systemd/user/ssh-agent.service"
fi

if [ "$NO_SYSTEMD" -eq 0 ] && command -v systemctl >/dev/null 2>&1; then
  systemctl --user stop ssh-agent.socket 2>/dev/null || true
  systemctl --user disable ssh-agent.socket 2>/dev/null || true
  systemctl --user daemon-reload || true
  systemctl --user reset-failed ssh-agent.service 2>/dev/null || true
  systemctl --user enable --now ssh-agent.service || true
fi

if [ -x "$START_AGENT_SCRIPT" ]; then
  "$START_AGENT_SCRIPT" || true
fi

printf 'YubiKey pool setup is complete. Test git key detection with:\n  %s --git\n' "$CURRENT_KEY_SCRIPT"
