#!/bin/sh

# throne-bin ships its own Qt 6.11 with only the gtk3/xdg-portal platform themes,
# so QT_QPA_PLATFORMTHEME=qt6ct is ignored. LD_LIBRARY_PATH outranks the binary's
# RUNPATH ($ORIGIN/usr/lib); the app then loads system Qt and its qt6ct plugin.
export LD_LIBRARY_PATH=/usr/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}

exec /usr/bin/throne "$@"
