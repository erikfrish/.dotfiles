#!/usr/bin/env bash
set -euo pipefail

speaker_sink="alsa_output.pci-0000_00_1f.3-platform-skl_hda_dsp_generic.HiFi__Speaker__sink"
hdmi1_sink="alsa_output.pci-0000_00_1f.3-platform-skl_hda_dsp_generic.HiFi__HDMI1__sink"
hdmi2_sink="alsa_output.pci-0000_00_1f.3-platform-skl_hda_dsp_generic.HiFi__HDMI2__sink"
hdmi3_sink="alsa_output.pci-0000_00_1f.3-platform-skl_hda_dsp_generic.HiFi__HDMI3__sink"
effects_sink="easyeffects_sink"

usage() {
  printf 'Usage: %s {speaker|enhanced|hdmi1|hdmi2|hdmi3|status}\n' "${0##*/}"
}

sink_exists() {
  pactl list sinks short | cut -f2 | grep -qx "$1"
}

set_sink() {
  local sink="$1"

  if ! sink_exists "$sink"; then
    printf 'Audio sink not available: %s\n' "$sink" >&2
    exit 1
  fi

  pactl set-default-sink "$sink"
  printf 'Default audio sink: %s\n' "$sink"
}

case "${1:-status}" in
  speaker)
    set_sink "$speaker_sink"
    ;;
  enhanced|effects|easyeffects)
    if ! sink_exists "$effects_sink"; then
      setsid -f easyeffects --service-mode --hide-window >/dev/null 2>&1
      sleep 1
    fi
    easyeffects --load-preset thinkpad-speakers >/dev/null 2>&1 || true
    set_sink "$effects_sink"
    ;;
  hdmi1)
    set_sink "$hdmi1_sink"
    ;;
  hdmi2)
    set_sink "$hdmi2_sink"
    ;;
  hdmi3)
    set_sink "$hdmi3_sink"
    ;;
  status)
    wpctl status | sed -n '/Sinks:/,/Sources:/p'
    printf '\nDefault sink: %s\n' "$(pactl get-default-sink)"
    ;;
  -h|--help|help)
    usage
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac
