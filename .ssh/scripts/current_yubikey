#!/usr/bin/env bash
set -euo pipefail

POOL_FILE="${YUBIKEY_POOL_FILE:-$HOME/.ssh/yubikeys.tsv}"
MODE="${1:---git}"

usage() {
  cat <<'EOF'
Usage: current_yubikey [--git|--env|--serial|--name|--identity|--public-key]

Detects the first connected YubiKey that is registered in ~/.ssh/yubikeys.tsv.
--git is the default and prints the format expected by git gpg.ssh.defaultKeyCommand.
EOF
}

die() {
  printf 'current_yubikey: %s\n' "$*" >&2
  exit 1
}

expand_path() {
  case "$1" in
    '~') printf '%s\n' "$HOME" ;;
    '~/'*) printf '%s/%s\n' "$HOME" "${1#~/}" ;;
    *) printf '%s\n' "$1" ;;
  esac
}

shell_quote() {
  printf "%s" "$1" | sed "s/'/'\\''/g; 1s/^/'/; \$s/\$/'/"
}

case "$MODE" in
  --git|--env|--serial|--name|--identity|--public-key) ;;
  -h|--help) usage; exit 0 ;;
  *) usage >&2; exit 2 ;;
esac

command -v ykman >/dev/null 2>&1 || die 'ykman is required to detect connected YubiKeys'
[ -r "$POOL_FILE" ] || die "pool file is missing or unreadable: $POOL_FILE"

while IFS= read -r connected_serial; do
  [ -n "$connected_serial" ] || continue

  while IFS=$'\t' read -r serial name identity_file public_key_file rest; do
    [ -n "${serial:-}" ] || continue
    case "$serial" in \#*) continue ;; esac
    [ "$serial" = "$connected_serial" ] || continue

    identity_file="$(expand_path "$identity_file")"
    public_key_file="$(expand_path "$public_key_file")"
    [ -r "$public_key_file" ] || die "public key for $name is missing: $public_key_file"

    case "$MODE" in
      --git)
        printf 'key::%s\n' "$(cat "$public_key_file")"
        ;;
      --env)
        printf 'export ACTIVE_HARDWARE_KEY_SERIAL=%s\n' "$(shell_quote "$serial")"
        printf 'export ACTIVE_HARDWARE_KEY_NAME=%s\n' "$(shell_quote "$name")"
        printf 'export ACTIVE_HARDWARE_KEY_IDENTITY=%s\n' "$(shell_quote "$identity_file")"
        printf 'export ACTIVE_HARDWARE_KEY_PUBLIC=%s\n' "$(shell_quote "$public_key_file")"
        ;;
      --serial) printf '%s\n' "$serial" ;;
      --name) printf '%s\n' "$name" ;;
      --identity) printf '%s\n' "$identity_file" ;;
      --public-key) printf '%s\n' "$public_key_file" ;;
    esac
    exit 0
  done < "$POOL_FILE"
done < <(ykman list -s)

die 'no connected YubiKey from the pool was found'
