#!/usr/bin/env bash
set -euo pipefail

POOL_FILE="${YUBIKEY_POOL_FILE:-$HOME/.ssh/yubikeys.tsv}"
DEFAULT_SSH_AUTH_SOCK="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/ssh-agent.socket"
export SSH_AUTH_SOCK="${SSH_AUTH_SOCK:-$DEFAULT_SSH_AUTH_SOCK}"

expand_path() {
  case "$1" in
    '~') printf '%s\n' "$HOME" ;;
    '~/'*) printf '%s/%s\n' "$HOME" "${1#\~/}" ;;
    *) printf '%s\n' "$1" ;;
  esac
}

add_identity() {
  local identity_file="$1"
  [ -r "$identity_file" ] || return 0
  SSH_AUTH_SOCK="$SSH_AUTH_SOCK" ssh-add "$identity_file" >/dev/null 2>&1 || true
}

agent_reachable() {
  local status
  SSH_AUTH_SOCK="$SSH_AUTH_SOCK" ssh-add -l >/dev/null 2>&1
  status=$?
  [ "$status" -eq 0 ] || [ "$status" -eq 1 ]
}

if ! agent_reachable && [ "$SSH_AUTH_SOCK" != "$DEFAULT_SSH_AUTH_SOCK" ]; then
  export SSH_AUTH_SOCK="$DEFAULT_SSH_AUTH_SOCK"
fi

if ! agent_reachable; then
  printf 'start_ssh_agent: ssh-agent is not reachable at %s\n' "$SSH_AUTH_SOCK" >&2
  exit 1
fi

if [ -r "$POOL_FILE" ]; then
  while IFS=$'\t' read -r serial name identity_file public_key_file rest; do
    [ -n "${serial:-}" ] || continue
    case "$serial" in \#*) continue ;; esac
    add_identity "$(expand_path "$identity_file")"
  done < "$POOL_FILE"
else
  for identity_file in "$HOME"/.ssh/id_ed25519_sk_rk*; do
    [ -e "$identity_file" ] || continue
    case "$identity_file" in *.pub) continue ;; esac
    add_identity "$identity_file"
  done
fi
