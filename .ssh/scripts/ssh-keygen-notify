#!/usr/bin/env bash
set -uo pipefail

REAL_SSH_KEYGEN="$(command -v ssh-keygen)"
KEY_TOUCH_SOUND="${KEY_TOUCH_SOUND:-/usr/share/sounds/freedesktop/stereo/dialog-warning.oga}"

notify_touch() {
    local title="${1:-🔑 YubiKey — нужен тап}"
    local msg="${2:-Git просит подпись. Коснитесь ключа, чтобы продолжить.}"
    local urgency="${3:-critical}"

    if command -v notify-send >/dev/null 2>&1; then
        notify-send -a opencode -u "$urgency" -t 20000 "$title" "$msg" >/dev/null 2>&1 || true
    fi

    if command -v paplay >/dev/null 2>&1 && [ -f "$KEY_TOUCH_SOUND" ]; then
        setsid paplay "$KEY_TOUCH_SOUND" >/dev/null 2>&1 &
    fi
}

is_sign_call() {
    [ $# -ge 2 ] && [ "$1" = "-Y" ] && [ "$2" = "sign" ]
}

if is_sign_call "$@"; then
    notify_touch "🔑 YubiKey — нужен тап" "Git просит подпись. Коснитесь ключа (yubik_5c_nano), чтобы продолжить."
fi

err_file="$(mktemp)"
"$REAL_SSH_KEYGEN" "$@" 2>"$err_file"
status=$?

if [ $status -ne 0 ] && is_sign_call "$@"; then
    if grep -q "agent refused operation\|Couldn't sign\|cancelled\|timeout" "$err_file" 2>/dev/null; then
        notify_touch "🔑 YubiKey — подпись не удалась" "Ключ не коснулись. Повторите операцию и коснитесь ключа." "normal"
    fi
fi
rm -f "$err_file"

exit $status
