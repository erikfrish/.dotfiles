#!/usr/bin/env bash
set -euo pipefail

CURRENT_KEY_SCRIPT="${CURRENT_YUBIKEY_SCRIPT:-$HOME/.ssh/scripts/current_yubikey}"
KNOWN_HOSTS="$HOME/.ssh/known_hosts"
CONTROL_PATH="$HOME/.ssh/ssh-conn-%C"

host_from_args() {
  local arg host
  for arg in "$@"; do
    case "$arg" in
      -*|*=*) continue ;;
      *@*)
        host="${arg#*@}"
        host="${host%%:*}"
        printf '%s\n' "$host"
        return 0
        ;;
      *)
        case "$arg" in
          github.com|gitlab.wildberries.ru)
            printf '%s\n' "$arg"
            return 0
            ;;
        esac
        ;;
    esac
  done
}

host="$(host_from_args "$@" || true)"

case "$host" in
  github.com|gitlab.wildberries.ru)
    identity="$($CURRENT_KEY_SCRIPT --identity)"
    exec ssh \
      -F /dev/null \
      -i "$identity" \
      -o IdentitiesOnly=yes \
      -o IdentityAgent=none \
      -o User=git \
      -o StrictHostKeyChecking=yes \
      -o UpdateHostKeys=no \
      -o UserKnownHostsFile="$KNOWN_HOSTS" \
      -o ControlMaster=auto \
      -o ControlPath="$CONTROL_PATH" \
      -o ControlPersist=4h \
      "$@"
    ;;
esac

exec ssh \
  -o StrictHostKeyChecking=yes \
  -o UpdateHostKeys=no \
  -o ControlMaster=auto \
  -o ControlPath="$CONTROL_PATH" \
  -o ControlPersist=4h \
  "$@"
