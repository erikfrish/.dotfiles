Include ~/.ssh/config.local
Include ~/.ssh/wb/config
Include ~/.ssh/config.d/yubikey-pool.conf

Host compik
	HostName 10.69.11.10
	User erikfrish

Host github.com
	HostName github.com
	User git
	StrictHostKeyChecking yes
	UpdateHostKeys no
	UserKnownHostsFile ~/.ssh/known_hosts
	ControlMaster auto
	ControlPath ~/.ssh/ssh-conn-%C
	ControlPersist 4h
	IdentitiesOnly yes

Host *
	AddKeysToAgent yes
	ControlMaster auto
	ControlPath ~/.ssh/ssh-conn-%C
	ControlPersist 30m
	ServerAliveInterval 60
	ServerAliveCountMax 3
	ForwardAgent yes
	IdentitiesOnly yes
